                    </div>
                    <div>
                        <h1 class="text-base font-extrabold tracking-tight leading-none flex items-center gap-1.5">
                            Sony<span class="text-cyan-400">Box</span>
                            <span class="text-[10px] bg-cyan-400/20 text-cyan-200 px-1.5 py-0.5 rounded font-mono font-bold">ISP</span>
                        </h1>
                        <span id="currentMonthYear" class="text-[11px] text-blue-200/90 font-medium">November 2026 Billing</span>
                    </div>
                </div>

                <div class="flex items-center gap-1.5">
                    <!-- ☁️ CLOUD SYNC BUTTON (MOBILE) -->
                    <button type="button" onclick="manualCloudSync(true)" id="cloudSyncBtnMob" 
                            class="bg-white/15 hover:bg-white/25 active:scale-95 text-white px-2.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition" 
                            title="Cloud Sync (Mobile & PC Data Merge)">
                        <i id="cloudSyncIconMob" class="fa-solid fa-cloud text-xs text-cyan-300"></i>
                        <span id="cloudSyncDotMob" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    </button>

                    <button onclick="openModal('addModal')" class="bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white text-xs font-bold px-3 py-1.5 rounded-xl shadow flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-user-plus text-xs"></i>
                        <span>Naya User</span>
                    </button>

                    <button onclick="lockApp()" class="bg-white/15 hover:bg-white/25 active:scale-95 text-white p-2 rounded-xl text-xs transition" title="App Lock Karein">
                        <i class="fa-solid fa-lock text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Top 3 KPI Cards -->
            <div id="mobileKpiSection" class="max-w-2xl mx-auto px-4 pb-3.5 pt-1">
                <div class="grid grid-cols-3 gap-2 text-center">
                    <!-- Mobile Card 1: Total Due (Baqi) -->
                    <div class="bg-white/10 backdrop-blur-md border border-rose-300/30 rounded-2xl p-2.5 text-left">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-rose-300 flex items-center gap-1">
                            <i class="fa-solid fa-hourglass-half text-[9px]"></i> Total Due (Baqi)
                        </div>
                        <div id="statPending" class="text-base font-black text-white mt-0.5">Rs 0</div>
                        <div id="statPendingCount" class="text-[10px] text-rose-200 font-medium">0 Baqi Bill</div>
                    </div>

                    <!-- Mobile Card 2: Wasool Shuda -->
                    <div class="bg-white/10 backdrop-blur-md border border-emerald-300/30 rounded-2xl p-2.5 text-left">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-emerald-300 flex items-center gap-1">
                            <i class="fa-solid fa-circle-check text-[9px]"></i> Wasool Shuda
                        </div>
                        <div id="statToday" class="text-base font-black text-white mt-0.5">Rs 0</div>
                        <div id="statPaidCount" class="text-[10px] text-emerald-200 font-medium">0 Ada Shuda</div>
                    </div>

                    <!-- Mobile Card 3: Kul Month Demand & Recovery -->
                    <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-2.5 text-left">
                        <div class="text-[10px] font-semibold uppercase tracking-wider text-cyan-300 flex items-center gap-1">
                            <i class="fa-solid fa-chart-pie text-[9px]"></i> Kul Demand
                        </div>
                        <div id="statTotalDemand" class="text-base font-black text-white mt-0.5">Rs 0</div>
                        <div id="statRate" class="text-[10px] text-blue-200 font-medium">0% Recovery</div>
                    </div>
                </div>
            </div>

            <!-- Mobile Dedicated Page Sub-Header (Shown when on All Customers / Default Users / Paid Pages) -->
            <div id="mobilePageNavBar" class="hidden max-w-2xl mx-auto px-4 py-2 border-t border-white/10 flex items-center justify-between text-xs">
                <button type="button" onclick="openPage('dashboard')" class="text-cyan-300 font-bold flex items-center gap-1.5 hover:text-white transition">
                    <i class="fa-solid fa-arrow-left text-[11px]"></i>
                    <span>Dashboard</span>
                </button>
                <div class="flex items-center gap-2">
                    <span id="mobilePageBadge" class="bg-white/20 text-white px-2 py-0.5 rounded-full font-bold text-[10px]">All Customers</span>
                    <button type="button" onclick="switchDedicatedPage()" id="mobileSwitchBtn" class="bg-rose-500/80 hover:bg-rose-500 text-white px-2 py-0.5 rounded-full font-bold text-[10px] flex items-center gap-1">
                        <i class="fa-solid fa-repeat text-[9px]"></i>
                        <span id="mobilePageSwitchText">Default Users</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Search & Area Filter Bar on Mobile -->
        <section class="max-w-2xl mx-auto w-full px-4 pt-3 space-y-2 sticky top-[138px] z-20 bg-slate-100/95 backdrop-blur-sm pb-1">
            <div class="relative">
                <input type="text" id="searchInput" oninput="syncSearch(this.value)" 
                       placeholder="Naam, Mobile #, ya User ID likhein..." 
                       class="w-full bg-white border border-slate-300 rounded-2xl py-2.5 pl-10 pr-9 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <button onclick="clearSearch()" id="clearBtn" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs p-1">
                    <i class="fa-solid fa-circle-xmark"></i>
                </button>
            </div>

            <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
                <select id="areaFilter" onchange="syncArea(this.value)" 
                        class="bg-white border border-slate-300 text-xs font-semibold rounded-xl px-2.5 py-1.5 text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm shrink-0">
                    <option value="ALL">Tamam Ilaqay / Galiyan</option>
                </select>

                <div class="flex bg-slate-200 p-0.5 rounded-xl shrink-0 text-xs font-bold">
                    <button onclick="filterStatus('ALL')" id="tabAll" class="px-3 py-1 rounded-lg text-slate-700 font-bold active-tab transition flex items-center gap-1">
                        <i class="fa-solid fa-users text-[10px]"></i>
                        <span>All (<span id="countAll">0</span>)</span>
                    </button>
                    <button onclick="filterStatus('PENDING')" id="tabPending" class="px-2.5 py-1 rounded-lg text-slate-700 font-semibold transition flex items-center gap-1">
                        <i class="fa-solid fa-user-xmark text-[10px] text-rose-500"></i>
                        <span>Default (<span id="countPending">0</span>)</span>
                    </button>
                    <button onclick="filterStatus('PAID')" id="tabPaid" class="px-2.5 py-1 rounded-lg text-slate-600 font-semibold transition flex items-center gap-1">
                        <i class="fa-solid fa-circle-check text-[10px] text-emerald-500"></i>
                        <span>Wasool (<span id="countPaid">0</span>)</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Customer Cards List on Mobile -->
        <main class="max-w-2xl mx-auto w-full px-4 py-3 flex-1">
            <!-- Mobile High Bill Auto-Fix Banner -->
            <div id="fixDataBannerMobile" class="hidden p-3.5 mb-3 bg-gradient-to-r from-amber-500 to-orange-600 text-white rounded-2xl shadow-md flex items-center justify-between gap-2">
                <div>
                    <div class="font-extrabold text-xs">Bill & Mobile Swap Masla!</div>
                    <div class="text-[10px] text-white/90">Phone number bill me chala gaya tha.</div>
                </div>
                <button type="button" onclick="fixCorruptedCustomerData(true)" class="px-3.5 py-1.5 bg-white text-orange-700 font-extrabold rounded-xl text-[11px] shadow shrink-0">
                    Auto Fix
                </button>
            </div>

            <!-- Mobile Default Users Alert Bar -->
            <div id="defaulterBannerMobile" class="hidden p-3.5 mb-3 bg-gradient-to-r from-rose-600 to-red-600 text-white rounded-2xl shadow-md flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-white/20 flex items-center justify-center text-sm font-bold shrink-0">
                        <i class="fa-solid fa-user-xmark"></i>
                    </div>
                    <div>
                        <div class="font-extrabold text-xs flex items-center gap-1.5">
                            <span>Default Users (Fees Baqi)</span>
                            <span id="defaulterMobBadge" class="bg-white/20 px-1.5 py-0.2 rounded text-[10px]">0</span>
                        </div>
                        <div class="text-[10px] text-rose-100" id="defaulterMobAmount">Baqi: Rs 0</div>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                    <button type="button" onclick="exportToCSV('PENDING')" class="px-2.5 py-1.5 bg-white text-rose-700 font-extrabold rounded-xl text-[10px] shadow flex items-center gap-1">
                        <i class="fa-solid fa-file-excel"></i>
                        <span>Excel</span>
                    </button>
                </div>
            </div>

            <div id="customerList" class="space-y-3 pb-24">
                <!-- Cards populated by JS -->
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden text-center py-12 px-4 bg-white rounded-3xl border border-dashed border-slate-300 mt-4">
                <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <h3 class="text-sm font-bold text-slate-800">Koi User Nahi Mila</h3>
                <p class="text-xs text-slate-500 mt-1">Search badlein ya naya customer add karein.</p>
                <button onclick="openModal('addModal')" class="mt-4 px-4 py-2 bg-blue-600 text-white text-xs font-bold rounded-xl shadow">
                    + Naya Customer Shamil Karein
                </button>
            </div>
        </main>

        <!-- Mobile Bottom Tab Navigation -->
        <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 z-30 shadow-lg pb-safe">
            <div class="max-w-2xl mx-auto grid grid-cols-5 text-center py-2 text-slate-500">
                <button type="button" onclick="toggleMobileSideMenu()" class="flex flex-col items-center gap-0.5 text-[10px] text-slate-600 hover:text-blue-600 font-semibold transition" title="Side Menu">
                    <i class="fa-solid fa-bars text-base text-blue-600"></i>
                    <span>Menu</span>
                </button>
                <button type="button" onclick="openPage('dashboard')" id="mobBottomNavDash" class="text-blue-600 font-bold flex flex-col items-center gap-0.5 text-[10px] transition" title="Dashboard">
                    <i class="fa-solid fa-chart-pie text-base"></i>
                    <span>Dashboard</span>
                </button>
                <button type="button" onclick="openPage('paidCustomers')" id="mobBottomNavPaid" class="flex flex-col items-center gap-0.5 text-[10px] text-slate-500 hover:text-emerald-600 font-medium transition" title="Paid Users Folder">
                    <i class="fa-solid fa-folder-closed text-base text-emerald-500"></i>
                    <span>Paid Folder</span>
                </button>
                <button type="button" onclick="openPage('defaultUsers')" id="mobBottomNavPending" class="flex flex-col items-center gap-0.5 text-[10px] text-slate-600 hover:text-rose-600 font-medium transition relative" title="Default Users Page">
                    <i class="fa-solid fa-user-xmark text-base text-rose-500"></i>
                    <span>Default</span>
                    <span id="mobBottomPendingBadge" class="absolute top-0 right-2 bg-rose-600 text-white text-[9px] px-1 rounded-full font-bold">0</span>
                </button>
                <button type="button" onclick="openModal('addModal')" class="flex flex-col items-center gap-0.5 text-[10px] hover:text-emerald-600 font-medium" title="Naya Customer">
                    <i class="fa-solid fa-circle-plus text-base text-emerald-600"></i>
                    <span>+ User</span>
                </button>
            </div>
        </nav>
    </div>


    <!-- ============================================================ -->
    <!-- 📋 MODAL 1: ADD / EDIT CUSTOMER (SHARED BY PC & MOBILE)      -->
    <!-- ============================================================ -->
    <div id="addModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b pb-3 border-slate-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                        <i class="fa-solid fa-user-plus text-xs"></i>
                    </div>
                    <h3 id="modalTitle" class="text-base font-bold text-slate-900">Naya Customer Shamil Karein</h3>
                </div>
                <button onclick="closeModal('addModal')" class="text-slate-400 hover:text-slate-600 p-1 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="customerForm" onsubmit="saveCustomer(event)" class="space-y-3.5 text-xs">
                <input type="hidden" id="editCustomerId" value="" />

                <div>
                    <label class="block font-bold text-slate-700 mb-1">User Ka Naam *</label>
                    <input type="text" id="custName" required placeholder="e.g. Haji Aslam, Muhammad Ali" 
                           class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">WhatsApp / Phone *</label>
                        <input type="tel" id="custPhone" required placeholder="03001234567" 
                               class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">PPPoE User ID / Cable</label>
                        <input type="text" id="custUserid" placeholder="e.g. aslam_fiber" 
                               class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Ilaqa / Gali No *</label>
                        <input type="text" id="custArea" required placeholder="e.g. Gali # 4, Main Bazar" 
                               class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Internet Speed / Plan</label>
                        <input type="text" id="custPackage" placeholder="e.g. 15 Mbps Fiber" 
                               class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Mahana Bill (PKR) *</label>
                        <input type="number" id="custFee" required min="100" step="50" placeholder="1500" 
                               class="w-full border border-slate-300 rounded-xl p-2.5 font-black text-slate-900 text-base focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Expiration Date (Expiry)</label>
                        <input type="date" id="custExpireDate" 
                               class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">PPPoE Password / Secret</label>
                    <input type="text" id="custPassword" placeholder="e.g. 123456 ya secret" 
                           class="w-full border border-slate-300 rounded-xl p-2.5 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>

                <div class="pt-2 flex items-center justify-end gap-2">
                    <button type="button" onclick="closeModal('addModal')" class="px-4 py-2.5 border border-slate-300 text-slate-700 font-bold rounded-xl">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-md flex items-center gap-1.5">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Customer Save Karein</span>
                    </button>
                </div>
            </form>
        </div>
    </div>


    <!-- ============================================================ -->
    <!-- ⚙️ MODAL 2: SETTINGS & SECURITY (SHARED BY PC & MOBILE)       -->
    <!-- ============================================================ -->
    <div id="settingsModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-3xl p-6 shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b pb-3 border-slate-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
                        <i class="fa-solid fa-sliders text-xs"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-900">ISP Settings & Security</h3>
                </div>
                <button onclick="closeModal('settingsModal')" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="space-y-4 text-xs">
                
                <!-- 🔒 SECURITY PIN SETTINGS -->
                <div class="p-3.5 bg-blue-50/80 rounded-2xl border border-blue-200/80 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-blue-950 flex items-center gap-1.5">
                            <i class="fa-solid fa-shield-halved text-blue-600"></i> Password / PIN Protection
                        </span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="lockEnabledToggle" onchange="toggleLockFeature()" class="sr-only peer">
                            <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
                        </label>
                    </div>
                    <p class="text-[11px] text-blue-800 leading-tight">
                        App ya portal khulte waqt PIN maangne ke liye is feature ko On rakhein.
                    </p>
                    
                    <div class="pt-1.5 border-t border-blue-200/60">
                        <label class="block font-bold text-blue-900 mb-1">Naya PIN Code Set Karein</label>
                        <div class="flex items-center gap-2">
                            <input type="text" id="newPinInput" maxlength="8" placeholder="e.g. 7860" 
                                   class="flex-1 border border-blue-200 rounded-xl p-2 font-mono font-bold text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                            <button type="button" onclick="updatePin()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-sm transition">
                                Change PIN
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ISP Business Name -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Apki ISP Ka Naam</label>
                    <input type="text" id="ispNameInput" onchange="updateIspName()" value="SonyBox" 
                           class="w-full border border-slate-300 rounded-xl p-2.5 font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>

                <!-- JazzCash / EasyPaisa & Helpline for WhatsApp Messages -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">JazzCash / EasyPaisa</label>
                        <input type="text" id="ispJazzcashInput" onchange="updatePaymentDetails()" placeholder="03001234567" 
                               class="w-full border border-slate-300 rounded-xl p-2 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Helpline / Rabta No</label>
                        <input type="text" id="ispHelplineInput" onchange="updatePaymentDetails()" placeholder="03001234567" 
                               class="w-full border border-slate-300 rounded-xl p-2 font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs">
                    </div>
                </div>

                <!-- Reset Month's Recovery Cycle -->
                <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200">
                    <div class="font-bold text-amber-900 flex items-center gap-1.5 mb-1">
                        <i class="fa-solid fa-rotate text-xs"></i> Naya Maheena Shuru Karein
                    </div>
                    <p class="text-[11px] text-amber-800 leading-relaxed mb-2.5">
                        Jab naya maheena aye (e.g. December), to click karein taake tamam customers ka status dobara "Pending (Baqi)" ho jaye.
                    </p>
                    <button onclick="startNewMonth()" class="w-full py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition shadow-sm">
                        Naya Maheena Reset Karein
                    </button>
                </div>

                <!-- Data Repair Tool -->
                <div class="p-3 bg-orange-50 rounded-2xl border border-orange-200">
                    <div class="font-bold text-orange-950 flex items-center gap-1.5 mb-1">
                        <i class="fa-solid fa-wrench text-xs text-orange-600"></i> Import Data & Bill Repair Tool
                    </div>
                    <p class="text-[11px] text-orange-800 leading-relaxed mb-2.5">
                        Agar Excel import karte waqt phone numbers bill ki jagah (Rs. 32 Billion) lag gaye hon to is button se foran asal phone number aur bill theek karein.
                    </p>
                    <button type="button" onclick="fixCorruptedCustomerData(true)" class="w-full py-2 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl transition shadow-sm flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span>High Bill & Phone Swap Theek Karein</span>
                    </button>
                </div>

                <!-- Backup & Restore -->
                <div class="border-t pt-3 flex flex-col gap-2">
                    <button onclick="exportJSONBackup()" class="w-full py-2.5 border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold rounded-xl flex items-center justify-center gap-2">
                        <i class="fa-solid fa-cloud-arrow-down text-blue-600"></i> Backup File Download Karein
                    </button>
                    <label class="w-full py-2.5 border border-dashed border-slate-300 hover:bg-slate-50 text-slate-700 font-bold rounded-xl flex items-center justify-center gap-2 cursor-pointer text-center">
                        <i class="fa-solid fa-cloud-arrow-up text-emerald-600"></i> Backup Restore / Upload
                        <input type="file" id="importFile" onchange="importJSONBackup(event)" class="hidden" accept=".json">
                    </label>
                </div>

            </div>

            <div class="pt-2">
                <button onclick="closeModal('settingsModal')" class="w-full py-2.5 bg-slate-900 text-white font-bold rounded-xl">
                    Band Karein
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ⚠️ MODAL 3: ACTION CONFIRMATION MODAL                        -->
    <!-- ============================================================ -->
    <div id="confirmModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center space-y-4">
            <div id="confirmIconBox" class="w-14 h-14 mx-auto rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-2xl shadow-inner">
                <i id="confirmIcon" class="fa-solid fa-circle-question"></i>
            </div>
            <div>
                <h3 id="confirmTitle" class="text-base font-black text-slate-900">Kya aap mutma'in hain?</h3>
                <p id="confirmMessage" class="text-xs text-slate-500 mt-1.5 leading-relaxed font-medium">Is action ko perform karne se pehle tasdeeq karein.</p>
            </div>
            <div class="grid grid-cols-2 gap-2.5 pt-2">
                <button type="button" onclick="closeConfirmModal()" 
                        class="w-full py-2.5 border border-slate-300 hover:bg-slate-50 active:bg-slate-100 text-slate-700 font-bold rounded-xl text-xs transition">
                    Cancel
                </button>
                <button type="button" id="confirmActionBtn" onclick="executeConfirmAction()" 
                        class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs shadow-md shadow-blue-500/25 transition">
                    Haan, Confirm Karein
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 💵 MODAL 3B: BILL WASOOLI & PARTIAL PAYMENT MODAL            -->
    <!-- ============================================================ -->
    <div id="paymentModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] flex items-center justify-center p-3 sm:p-5">
        <div class="bg-white w-full max-w-2xl rounded-2xl p-4 sm:p-6 shadow-2xl space-y-3 max-h-[92vh] overflow-y-auto">
            
            <!-- Header (Exact Match: Title & Close Cross) -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                <div class="flex items-center gap-2.5">
                    <h3 class="text-xl font-bold text-slate-800 tracking-tight">Receiving</h3>
                    <button type="button" onclick="openHistoryModalFromPayModal()" 
                            class="px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 rounded-lg text-xs font-bold flex items-center gap-1 transition shadow-2xs" title="Customer ki Paid History Dekhein">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>History</span>
                    </button>
                </div>
                <button type="button" onclick="closeModal('paymentModal')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1 transition" title="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Customer Summary Bar (Exact Match with Image: CUSTID | NAME | MONTH/YEAR | TYPE | NET AMOUNT) -->
            <input type="hidden" id="payModalCustomerId" value="" />
            <div class="overflow-x-auto pb-1">
                <div class="grid grid-cols-5 gap-3 sm:gap-4 text-left min-w-[500px] py-1">
                    <div>
                        <span class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">CUSTID</span>
                        <span class="block text-sm font-bold text-slate-900 mt-1" id="payModalCustIdDisplay">3461</span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">NAME</span>
                        <span class="block text-sm font-bold text-slate-900 mt-1 truncate" id="payModalCustName">PEER-zoraiz</span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">MONTH/YEAR</span>
                        <span class="block text-sm font-bold text-slate-900 mt-1" id="payModalMonthYear">Nov 2026</span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">TYPE</span>
                        <span class="block text-sm font-bold text-slate-900 mt-1" id="payModalTypeDisplay">Internet</span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">NET AMOUNT</span>
                        <span class="block text-sm font-bold text-slate-900 mt-1" id="payModalCustFee">1000</span>
                    </div>
                </div>
            </div>

            <hr class="border-t border-slate-200 my-1" />

            <!-- Form Inputs (Exact Match with Image) -->
            <div class="space-y-4 pt-1">
                <!-- Row 1: Reciept ID * | Receiving Date * | Connection Type * -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1.5">
                            Reciept ID <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" id="payReceiptId" 
                               class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1.5">
                            Receiving Date <span class="text-rose-500">*</span>
                        </label>
                        <input type="date" id="payReceivingDate" 
                               class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1.5">
                            Connection Type <span class="text-rose-500">*</span>
                        </label>
                        <select id="payConnectionType" 
                                class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm">
                            <option value="Internet" selected>Internet</option>
                            <option value="Cable TV">Cable TV</option>
                            <option value="Fiber Net">Fiber Net</option>
                            <option value="Dedicated IP">Dedicated IP</option>
                        </select>
                    </div>
                </div>

                <!-- Row 2: Receive Amount * | Cash Type * -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-xs font-bold text-slate-800">
                                Receive Amount <span class="text-rose-500">*</span>
                            </label>
                            <span class="text-[10px] text-slate-400 font-medium">(Editable)</span>
                        </div>
                        <div class="relative">
                            <input type="number" id="payAmountInput" min="0" step="50" 
                                   class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm"
                                   oninput="onPayAmountInput()"
                                   onkeydown="if(event.key==='Enter') confirmPaymentCollection()" />
                        </div>
                        <!-- Quick Amount Chips -->
                        <div class="flex items-center gap-1.5 pt-2 flex-wrap text-xs" id="payQuickChips">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-800 mb-1.5">
                            Cash Type <span class="text-rose-500">*</span>
                        </label>
                        <select id="payCashType" 
                                class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm">
                            <option value="Cash" selected>Cash</option>
                            <option value="JazzCash">JazzCash</option>
                            <option value="EasyPaisa">EasyPaisa</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Other">Other</option>
                        </select>
                        <div id="payModalAlreadyPaid" class="hidden text-[11px] text-emerald-600 font-bold mt-2"></div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Calculation Box for Partial vs Full Payments -->
            <div id="payCalculationBox" class="p-3 rounded-xl text-xs space-y-1 border transition">
            </div>

            <!-- Partial Mode Choice (when amount < due) -->
            <div id="partialChoiceContainer" class="hidden p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs space-y-2">
                <span class="font-bold text-amber-900 block flex items-center gap-1.5 text-[11px]">
                    <i class="fa-solid fa-circle-info text-amber-600"></i>
                    Baqi Rakam Ka Tareeqa:
                </span>
                <div class="space-y-1.5 text-[11px]">
                    <label class="flex items-start gap-2 cursor-pointer font-medium text-slate-800">
                        <input type="radio" name="payPartialMode" value="keep_due" checked class="mt-0.5 text-amber-600 focus:ring-amber-500" />
                        <div>
                            <span class="font-bold block text-slate-900">Partial Payment (Baqi pending rahe)</span>
                            <span class="text-[10px] text-slate-500 block">Baqi raqam Defaulters list mein show hoti rahegi.</span>
                        </div>
                    </label>
                    <label class="flex items-start gap-2 cursor-pointer font-medium text-slate-800">
                        <input type="radio" name="payPartialMode" value="discount_settle" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                        <div>
                            <span class="font-bold block text-slate-900">Discount / Full Settlement (Bill khatam)</span>
                            <span class="text-[10px] text-slate-500 block">Is maheenay ka bill itna hi samajh kar Mukammal Paid mark karein.</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Optional WhatsApp Receipt Checkbox -->
            <div class="pt-1">
                <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700 hover:text-slate-900 transition">
                    <input type="checkbox" id="paySendWhatsAppReceipt" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer" />
                    <span class="flex items-center gap-1.5">
                        <i class="fa-brands fa-whatsapp text-emerald-600 text-sm"></i>
                        <span>Adaigi ke baad WhatsApp Rasid kholen</span>
                    </span>
                </label>
            </div>

            <hr class="border-t border-slate-200 pt-1" />

            <!-- Footer Buttons (Exact Match with Image: Close & Submit on the Right + Left Unpaid button for Partial/Paid) -->
            <div class="flex items-center justify-between gap-2.5 pt-1">
                <div>
                    <button type="button" id="payModalUnpaidBtn" onclick="onModalUnpaidClick()" 
                            class="hidden px-3.5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold rounded-lg text-xs flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-arrow-rotate-left"></i>
                        <span>Bill Unpaid Karein</span>
                    </button>
                </div>
                <div class="flex items-center gap-2.5">
                    <button type="button" onclick="closeModal('paymentModal')" 
                            class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg text-sm transition">
                        Close
                    </button>
                    <button type="button" id="payModalConfirmBtn" onclick="confirmPaymentCollection()" 
                            class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 active:scale-98 text-white font-bold rounded-lg text-sm shadow-md shadow-blue-500/20 transition">
                        Submit
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 📜 MODAL 3C: PAID HISTORY (Full Width - No Horizontal Scrollbar) -->
    <!-- ============================================================ -->
    <div id="historyModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-[100] flex items-center justify-center p-2 sm:p-4">
        <div class="bg-white w-full max-w-[96vw] 2xl:max-w-[1400px] rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[94vh]">
            
            <!-- Header -->
            <div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-slate-200 bg-slate-50/50">
                <div>
                    <div class="flex items-center gap-2.5">
                        <h3 class="text-xl font-black text-slate-900 tracking-tight">Paid History</h3>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-blue-100 text-blue-800 border border-blue-200">
                            Live Ledger
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5" id="historyModalSubtitle">User: -</p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="openAddHistoryRecordModal()" 
                            class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-sm shadow-blue-500/20 flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-plus"></i>
                        <span>+ Nayi Entry</span>
                    </button>
                    <button type="button" onclick="closeModal('historyModal')" class="text-slate-400 hover:text-slate-700 text-xl font-bold p-1.5 rounded-lg hover:bg-slate-100 transition" title="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Table Container (Responsive Fit - No Slide Bar) -->
            <div class="overflow-y-auto flex-1 p-2 sm:p-4">
                <table class="w-full text-left border-collapse text-xs table-auto">
                    <thead>
                        <tr class="border-b border-slate-200 text-[11px] font-bold text-slate-600 uppercase tracking-wider bg-slate-50/70">
                            <th class="py-3 px-3 whitespace-nowrap">BILL ID</th>
                            <th class="py-3 px-3 whitespace-nowrap">MONTH/YEAR</th>
                            <th class="py-3 px-3 whitespace-nowrap">COLLECTION TYPE</th>
                            <th class="py-3 px-3 whitespace-nowrap">PAYMENT TYPE</th>
                            <th class="py-3 px-3 whitespace-nowrap">RECEIVED AMOUNT</th>
                            <th class="py-3 px-3 whitespace-nowrap">RECEIVED DATE</th>
                            <th class="py-3 px-3 text-center whitespace-nowrap">STATUS</th>
                            <th class="py-3 px-3 whitespace-nowrap">REMARKS</th>
                            <th class="py-3 px-3 whitespace-nowrap">RECEIVED BY</th>
                            <th class="py-3 px-3 text-center whitespace-nowrap">OPTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-slate-100 text-xs text-slate-800 font-medium">
                        <!-- Dynamically filled -->
                    </tbody>
                </table>
                <div id="historyEmptyState" class="hidden py-12 text-center text-slate-400 space-y-2">
                    <i class="fa-solid fa-receipt text-3xl text-slate-300"></i>
                    <p class="text-sm font-semibold">Is user ki abhi tak koi receiving history nahi hai.</p>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between px-5 sm:px-6 py-3 border-t border-slate-200 bg-slate-50 text-xs text-slate-500">
                <span id="historyRecordCount" class="font-bold text-slate-700">Total Records: 0</span>
                <button type="button" onclick="closeModal('historyModal')" class="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl transition shadow-sm">
                    Close
                </button>
            </div>

        </div>
    </div>

    <!-- Floating 3-Dots Options Menu -->
    <div id="historyOptionsMenu" 
         style="position: fixed; z-index: 999999 !important;" 
         class="hidden bg-white rounded-2xl shadow-2xl border border-slate-200 py-1.5 w-52 text-xs text-slate-700 transition">
        <div class="px-3.5 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-400 border-b border-slate-100 flex items-center justify-between">
            <span>Bill Actions</span>
            <span id="historyMenuBillId" class="text-blue-600 font-mono"></span>
        </div>
        <button type="button" onclick="triggerHistoryAction('duplicate')" class="w-full px-4 py-2.5 text-left hover:bg-blue-50 hover:text-blue-700 flex items-center gap-2.5 font-bold transition">
            <i class="fa-solid fa-file-invoice text-blue-600 text-sm w-4 text-center"></i>
            <span>Duplicate Bill</span>
        </button>
        <button type="button" onclick="triggerHistoryAction('print')" class="w-full px-4 py-2.5 text-left hover:bg-indigo-50 hover:text-indigo-700 flex items-center gap-2.5 font-bold transition">
            <i class="fa-solid fa-print text-indigo-600 text-sm w-4 text-center"></i>
            <span>Print</span>
        </button>
        <button type="button" onclick="triggerHistoryAction('details')" class="w-full px-4 py-2.5 text-left hover:bg-emerald-50 hover:text-emerald-700 flex items-center gap-2.5 font-bold transition">
            <i class="fa-solid fa-eye text-emerald-600 text-sm w-4 text-center"></i>
            <span>View Details</span>
        </button>
        <div class="border-t border-slate-100 my-1"></div>
        <button type="button" onclick="triggerHistoryAction('unpaid')" class="w-full px-4 py-2.5 text-left hover:bg-rose-50 text-rose-600 flex items-center gap-2.5 font-bold transition">
            <i class="fa-solid fa-arrow-rotate-left text-rose-500 text-sm w-4 text-center"></i>
            <span>Unpaid</span>
        </button>
    </div>

    <!-- ============================================================ -->
    <!-- 📄 MODAL 3D: DUPLICATE BILL MODAL                            -->
    <!-- ============================================================ -->
    <div id="duplicateBillModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-[110] flex items-center justify-center p-3 sm:p-5">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-200 bg-slate-50">
                <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-black tracking-wider uppercase bg-blue-100 text-blue-800 border border-blue-200">
                        Duplicate Bill / Copy
                    </span>
                </div>
                <button type="button" onclick="closeModal('duplicateBillModal')" class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Bill Content Printable Area -->
            <div id="printableBillArea" class="p-6 space-y-4 text-xs text-slate-800 bg-white">
                <!-- Dynamically populated duplicate bill receipt layout -->
            </div>

            <!-- Footer with Actions -->
            <div class="flex items-center justify-between gap-2 px-5 py-3 border-t border-slate-200 bg-slate-50">
                <button type="button" onclick="sendDuplicateBillWhatsApp()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs flex items-center gap-1.5 shadow-sm transition">
                    <i class="fa-brands fa-whatsapp text-sm"></i>
                    <span>WhatsApp</span>
                </button>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="printHistoryBillCurrent()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs flex items-center gap-1.5 shadow-sm transition">
                        <i class="fa-solid fa-print"></i>
                        <span>Print</span>
                    </button>
                    <button type="button" onclick="closeModal('duplicateBillModal')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-lg text-xs transition">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 👁️ MODAL 3E: TRANSACTION DETAILS MODAL                       -->
    <!-- ============================================================ -->
    <div id="historyDetailsModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-[110] flex items-center justify-center p-3 sm:p-5">
        <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-900">Transaction Details</h3>
                </div>
                <button type="button" onclick="closeModal('historyDetailsModal')" class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div id="historyDetailsContent" class="p-6 space-y-3.5 text-xs text-slate-700 max-h-[70vh] overflow-y-auto">
                <!-- Dynamically populated -->
            </div>
            <div class="flex items-center justify-end px-6 py-3 border-t border-slate-200 bg-slate-50">
                <button type="button" onclick="closeModal('historyDetailsModal')" class="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg text-xs transition">
                    Done
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ➕ MODAL 3F: ADD HISTORICAL RECORD MODAL                     -->
    <!-- ============================================================ -->
    <div id="addHistoryModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-[115] flex items-center justify-center p-3 sm:p-5">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-200">
                <h3 class="text-base font-bold text-slate-900">Purani Wasooli Shamil Karein</h3>
                <button type="button" onclick="closeModal('addHistoryModal')" class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form onsubmit="saveCustomHistoryRecord(event)" class="p-5 space-y-3 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Month / Year *</label>
                    <input type="text" id="histInputMonthYear" placeholder="e.g. Oct 2026" required class="w-full px-3 py-2 border border-slate-300 rounded-lg font-medium text-xs focus:ring-2 focus:ring-blue-500" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Wasool Raqam *</label>
                        <input type="number" id="histInputAmount" min="0" required class="w-full px-3 py-2 border border-slate-300 rounded-lg font-bold text-xs focus:ring-2 focus:ring-blue-500" />
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Status *</label>
                        <select id="histInputStatus" class="w-full px-3 py-2 border border-slate-300 rounded-lg font-medium text-xs focus:ring-2 focus:ring-blue-500">
                            <option value="paid" selected>paid</option>
                            <option value="partial">partial</option>
                            <option value="unpaid">unpaid</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Connection Type</label>
                        <select id="histInputConnType" class="w-full px-3 py-2 border border-slate-300 rounded-lg font-medium text-xs">
                            <option value="Internet" selected>Internet</option>
                            <option value="Cable TV">Cable TV</option>
                            <option value="Fiber Net">Fiber Net</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Payment Method</label>
                        <select id="histInputCashType" class="w-full px-3 py-2 border border-slate-300 rounded-lg font-medium text-xs">
                            <option value="Cash" selected>Cash</option>
                            <option value="JazzCash">JazzCash</option>
                            <option value="EasyPaisa">EasyPaisa</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Received Date *</label>
                    <input type="datetime-local" id="histInputDate" class="w-full px-3 py-2 border border-slate-300 rounded-lg font-medium text-xs" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Remarks (Optional)</label>
                    <input type="text" id="histInputRemarks" placeholder="Koi khas note..." class="w-full px-3 py-2 border border-slate-300 rounded-lg font-medium text-xs" />
                </div>
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                    <button type="button" onclick="closeModal('addHistoryModal')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg text-xs">Cancel</button>
                    <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-xs shadow-sm">Save Entry</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 📥 MODAL 4: UNIVERSAL BULK IMPORTER                          -->
    <!-- ============================================================ -->
    <div id="importModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-lg rounded-3xl p-6 sm:p-7 shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto">
            
            <div class="flex items-center justify-between border-b pb-3 border-slate-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center text-base shadow-sm">
                        <i class="fa-solid fa-file-import"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Universal Bulk Importer</h3>
                        <p class="text-[11px] text-slate-500">Apne tamam users 1-Click mein shamil karein</p>
                    </div>
                </div>
                <button onclick="closeModal('importModal')" class="text-slate-400 hover:text-slate-600 p-1 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Download Sample Template Box -->
            <div class="p-3 bg-blue-50/80 rounded-2xl border border-blue-200/80 flex items-center justify-between text-xs">
                <div>
                    <span class="font-bold text-blue-900 block">Excel / CSV 8-Column Template:</span>
                    <span class="text-[11px] text-blue-700">Format: Name, Phone, UserID, Area, Package, Monthly Fee, expiration_date, Password</span>
                </div>
                <button type="button" onclick="downloadSampleCSV()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs shadow-sm flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-download"></i>
                    <span>Template</span>
                </button>
            </div>

            <!-- Method 1: Upload CSV/Excel File -->
            <div>
                <label class="block font-bold text-slate-700 mb-1.5 text-xs">1. Excel ya CSV File Upload Karein:</label>
                <label class="w-full border-2 border-dashed border-slate-300 hover:border-blue-500 hover:bg-blue-50/30 p-4 rounded-2xl flex flex-col items-center justify-center cursor-pointer transition text-center group">
                    <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-400 group-hover:text-blue-600 mb-1 transition"></i>
                    <span class="text-xs font-bold text-slate-700" id="importFileName">File muntakhib karein (.csv ya .txt)</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">Click karein ya file drag & drop karein</span>
                    <input type="file" id="csvFileInput" accept=".csv,.txt" onchange="handleFileSelect(event)" class="hidden">
                </label>
            </div>

            <!-- Method 2: Direct Copy & Paste -->
            <div>
                <label class="block font-bold text-slate-700 mb-1 text-xs">2. Ya Direct Excel Se Copy & Paste Karein (Tab ya Comma Delimited):</label>
                <textarea id="csvPasteArea" rows="4" placeholder="Name&#9;Phone&#9;UserID&#9;Area&#9;Package&#9;Monthly Fee&#9;expiration_date&#9;Password&#10;Ali Khan&#9;03001234567&#9;ali_fiber&#9;Gali # 1&#9;15 Mbps&#9;1500&#9;2026-11-30&#9;123456&#10;Usman Net&#9;03211112233&#9;usman_net&#9;Main Bazar&#9;20 Mbps&#9;1800&#9;2026-12-05&#9;pass@786" 
                          class="w-full border border-slate-300 rounded-2xl p-3 font-mono text-[11px] text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 placeholder:text-slate-400"></textarea>
                <div class="text-[10px] text-slate-500 mt-1">Excel Sheet ke 8 Columns: <code>Name | Phone | UserID | Area | Package | Monthly Fee | expiration_date | Password</code></div>
            </div>

            <!-- Import Mode: Append or Replace -->
            <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200 text-xs space-y-1.5">
                <span class="font-bold text-slate-700 block">Import ka Tareeqa:</span>
                <div class="flex items-center gap-4">
                    <label class="flex items-center gap-1.5 cursor-pointer font-medium text-slate-700">
                        <input type="radio" name="importMode" value="append" checked class="text-blue-600 focus:ring-blue-500">
                        <span>Pehle se majood users mein shamil karein (Add)</span>
                    </label>
                    <label class="flex items-center gap-1.5 cursor-pointer font-medium text-rose-700">
                        <input type="radio" name="importMode" value="replace" class="text-rose-600 focus:ring-rose-500">
                        <span>Purana data saaf karke naye shamil karein (Replace)</span>
                    </label>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeModal('importModal')" class="px-4 py-2.5 border border-slate-300 text-slate-700 font-bold rounded-xl text-xs hover:bg-slate-50 transition">
                    Cancel
                </button>
                <button type="button" onclick="processBulkImport()" class="px-5 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-xl text-xs shadow-md shadow-cyan-500/25 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-file-import"></i>
                    <span>Bulk Import Shuru Karein</span>
                </button>
            </div>

        </div>
    </div>


    <!-- ============================================================ -->
    <!-- 📤 MODAL 5: UNIVERSAL EXPORTER                               -->
    <!-- ============================================================ -->
    <div id="exportModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-3xl p-6 sm:p-7 shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto">
            
            <div class="flex items-center justify-between border-b pb-3 border-slate-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-base shadow-sm">
                        <i class="fa-solid fa-file-export"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Universal Data Exporter</h3>
                        <p class="text-[11px] text-slate-500">Excel reports aur backup download karein</p>
                    </div>
                </div>
                <button onclick="closeModal('exportModal')" class="text-slate-400 hover:text-slate-600 p-1 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-2.5">
                
                <!-- Option 1: Full Excel Report -->
                <button type="button" onclick="exportToCSV('ALL')" 
                        class="w-full text-left p-3.5 rounded-2xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/30 transition flex items-center justify-between group">
