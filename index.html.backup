<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>SonyBox ISP - Web Portal & Recovery App</title>
    
    <!-- PWA & Mobile Web Capabilities -->
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="assets/images/logo-icon.svg" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#2563eb',
                            600: '#1d4ed8',
                            700: '#1e40af',
                            800: '#1e3a8a',
                            900: '#0f172a'
                        }
                    }
                }
            }
        }
    </script>

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Chart.js (for Desktop Analytics) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Toastr & jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 20px);
        }
        .active-tab {
            background-color: #2563eb !important;
            color: #ffffff !important;
            font-weight: 700;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .shake {
            animation: shake 0.4s ease-in-out;
        }

        /* 📱 Desktop Sidebar Minimize / Maximize */
        #desktopSidebar {
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #desktopSidebar.sidebar-collapsed {
            width: 4.75rem !important; /* 76px compact */
            padding-left: 0.65rem !important;
            padding-right: 0.65rem !important;
        }
        #desktopSidebar.sidebar-collapsed .sidebar-label,
        #desktopSidebar.sidebar-collapsed .sidebar-badge,
        #desktopSidebar.sidebar-collapsed .sidebar-text-content {
            display: none !important;
        }
        #desktopSidebar.sidebar-collapsed .sidebar-header {
            justify-content: center !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-bottom: 1.25rem !important;
        }
        #desktopSidebar.sidebar-collapsed .sidebar-header #sidebarInnerToggleBtn {
            display: none !important;
        }
        #desktopSidebar.sidebar-collapsed nav button {
            justify-content: center !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
        #desktopSidebar.sidebar-collapsed nav button i {
            margin: 0 !important;
            font-size: 1.1rem !important;
        }
        #desktopSidebar.sidebar-collapsed #sidebarFooter .admin-profile-box {
            justify-content: center !important;
        }
        #desktopSidebar.sidebar-collapsed #sidebarFooter .lock-btn {
            display: none !important;
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 antialiased select-none">

    <!-- ============================================================ -->
    <!-- 🔒 UNIFIED SECURITY LOCK SCREEN (FOR PC & MOBILE)            -->
    <!-- ============================================================ -->
    <div id="lockScreen" class="fixed inset-0 bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 z-50 flex items-center justify-center p-4">
        <div id="lockCard" class="w-full max-w-sm bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-6 sm:p-8 text-white shadow-2xl text-center space-y-5">
            
            <div class="flex flex-col items-center">
                <div class="w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md border border-white/25 flex items-center justify-center p-2.5 shadow-xl mb-3">
                    <img src="assets/images/logo-icon.svg" alt="SonyBox" class="w-full h-full object-contain drop-shadow" />
                </div>
                <h2 class="text-xl font-black tracking-tight">Sony<span class="text-cyan-400">Box</span> <span class="text-xs bg-cyan-400/20 text-cyan-300 px-2 py-0.5 rounded-full font-mono">ISP</span></h2>
                <p class="text-xs text-blue-200/80 mt-1">App & Portal Locked - Enter PIN</p>
            </div>

            <!-- PIN Input Display (Supports Keyboard typing on PC & touch on phone) -->
            <div class="space-y-2">
                <div class="relative">
                    <input type="password" id="pinInput" maxlength="12" placeholder="• • • •" autocomplete="off"
                           class="w-full text-center tracking-[12px] text-2xl font-black py-3 px-4 bg-white/15 border-2 border-white/30 rounded-2xl text-white placeholder:text-white/40 focus:outline-none focus:border-cyan-400 focus:bg-white/20 transition">
                    <button type="button" onclick="clearPin()" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-white/50 hover:text-white text-sm p-1">
                        <i class="fa-solid fa-delete-left"></i>
                    </button>
                </div>
                <div id="lockErrorMsg" class="text-xs font-semibold text-rose-400 min-h-[16px]"></div>
            </div>

            <!-- On-Screen Numeric Keypad (Great on mobile, optional on PC) -->
            <div class="grid grid-cols-3 gap-2.5 max-w-[280px] mx-auto text-xl font-bold">
                <button type="button" onclick="pressPin('1')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">1</button>
                <button type="button" onclick="pressPin('2')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">2</button>
                <button type="button" onclick="pressPin('3')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">3</button>

                <button type="button" onclick="pressPin('4')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">4</button>
                <button type="button" onclick="pressPin('5')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">5</button>
                <button type="button" onclick="pressPin('6')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">6</button>

                <button type="button" onclick="pressPin('7')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">7</button>
                <button type="button" onclick="pressPin('8')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">8</button>
                <button type="button" onclick="pressPin('9')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">9</button>

                <button type="button" onclick="clearPin()" class="py-3 bg-white/5 hover:bg-white/15 text-sm font-semibold rounded-2xl border border-white/10 transition text-rose-300">Clear</button>
                <button type="button" onclick="pressPin('0')" class="py-3 bg-white/10 hover:bg-white/20 active:bg-cyan-500/40 rounded-2xl border border-white/10 transition">0</button>
                <button type="button" onclick="checkUnlock()" class="py-3 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black rounded-2xl shadow-lg shadow-cyan-500/30 transition flex items-center justify-center">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Unlock Action & Default PIN hint -->
            <div class="pt-2">
                <button type="button" onclick="checkUnlock()" 
                        class="w-full py-3 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-extrabold text-sm rounded-2xl shadow-lg transition">
                    Unlock Portal <i class="fa-solid fa-lock-open ml-1 text-xs"></i>
                </button>
                
                <div class="mt-3 flex items-center justify-between text-[11px] text-blue-200/70">
                    <span>Default PIN: <strong class="text-cyan-300 font-mono">1234</strong></span>
                    <button type="button" onclick="autoFillPin()" class="text-cyan-300 hover:underline font-semibold">
                        Auto Fill 1234
                    </button>
                </div>
            </div>

        </div>
    </div>


    <!-- ============================================================ -->
    <!-- 💻 DESKTOP LAYOUT (LARGE SCREENS: SIDEBAR + MAIN PORTAL)     -->
    <!-- ============================================================ -->
    <div class="hidden lg:flex min-h-screen">
        
        <!-- Left Sidebar Navigation -->
        <aside id="desktopSidebar" class="w-64 bg-slate-900 text-white flex-shrink-0 flex flex-col justify-between p-5 border-r border-slate-800 transition-all duration-300 ease-in-out">
            <div>
                <!-- Brand Logo Header with Collapse Action Button -->
                <div class="flex items-center justify-between px-1 py-2 mb-6 sidebar-header">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <img src="assets/images/logo-icon.svg" alt="SonyBox" class="w-9 h-9 object-contain drop-shadow shrink-0" />
                        <div class="sidebar-text-content transition-all duration-300">
                            <span class="text-base font-black tracking-tight text-white block leading-tight">Sony<span class="text-cyan-400">Box</span></span>
                            <span class="text-[9px] text-blue-300 uppercase tracking-widest font-bold font-mono">ISP Web Portal</span>
                        </div>
                    </div>
                    <button onclick="toggleSidebar()" id="sidebarInnerToggleBtn" 
                            class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center justify-center shrink-0" 
                            title="Sidebar Minimize / Maximize">
                        <i id="sidebarInnerToggleIcon" class="fa-solid fa-angles-left text-xs"></i>
                    </button>
                </div>

                <!-- Navigation Links -->
                <div class="space-y-4">
                    <div>
                        <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider px-3 mb-1.5 sidebar-label">Pages / Directory</div>
                        <nav class="space-y-1 text-xs font-semibold">
                            <button onclick="openPage('dashboard'); return false;" id="navBtnDashboard" 
                                    class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-blue-600 text-white font-bold transition shadow-sm" title="Dashboard (Baqi Recovery)">
                                <i class="fa-solid fa-chart-pie w-5 text-center text-sm text-cyan-400"></i>
                                <span class="sidebar-label font-bold">Dashboard (Overview)</span>
                            </button>
                            <button onclick="openPage('paidCustomers'); return false;" id="navBtnPaid" 
                                    class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition group" title="Paid Users Folder (Ada Shuda Bills)">
                                <i class="fa-solid fa-folder-closed group-hover:fa-folder-open w-5 text-center text-sm text-emerald-400 transition-transform"></i>
                                <span class="sidebar-label font-bold text-emerald-300">Paid Users Folder</span>
                                <span class="ml-auto bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full text-[10px] font-bold sidebar-badge" id="deskCountPaid">0</span>
                            </button>
                            <button onclick="openPage('defaultUsers'); return false;" id="navBtnPending" 
                                    class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="Default Users Page (Fees Baqi)">
                                <i class="fa-solid fa-user-xmark w-5 text-center text-sm text-rose-400"></i>
                                <span class="sidebar-label font-bold text-rose-300">Default Users Page</span>
                                <span class="ml-auto bg-rose-500/20 text-rose-300 border border-rose-500/30 px-2 py-0.5 rounded-full text-[10px] font-bold sidebar-badge" id="deskCountPending">0</span>
                            </button>
                            <button onclick="openPage('allCustomers'); return false;" id="navBtnAll" 
                                    class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="All Customers Page">
                                <i class="fa-solid fa-users w-5 text-center text-sm text-blue-400"></i>
                                <span class="sidebar-label font-bold">All Customers Directory</span>
                                <span class="ml-auto bg-blue-500/40 text-white px-2 py-0.5 rounded-full text-[10px] font-bold sidebar-badge" id="deskCountAllNav">0</span>
                            </button>
                        </nav>
                    </div>

                    <div>
                        <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider px-3 mb-1.5 sidebar-label">System Tools</div>
                        <nav class="space-y-1 text-xs font-semibold">
                            <button onclick="openModal('addModal')" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="Naya User">
                                <i class="fa-solid fa-user-plus w-5 text-center text-sm text-blue-400"></i>
                                <span class="sidebar-label">Naya User</span>
                            </button>
                            <button type="button" onclick="manualCloudSync(true)" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="Live Cloud Sync">
                                <i class="fa-solid fa-cloud-arrow-up w-5 text-center text-sm text-cyan-400"></i>
                                <span class="sidebar-label">Live Cloud Sync</span>
                                <span class="ml-auto w-2 h-2 rounded-full bg-emerald-500 sidebar-badge"></span>
                            </button>
                            <button onclick="openModal('importModal')" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="Universal Importer">
                                <i class="fa-solid fa-file-import w-5 text-center text-sm text-cyan-400"></i>
                                <span class="sidebar-label">Universal Importer</span>
                            </button>
                            <button onclick="openModal('exportModal')" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="Universal Exporter">
                                <i class="fa-solid fa-file-export w-5 text-center text-sm text-emerald-400"></i>
                                <span class="sidebar-label">Universal Exporter</span>
                            </button>
                            <button onclick="openModal('settingsModal')" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition" title="Settings & Security">
                                <i class="fa-solid fa-sliders w-5 text-center text-sm text-slate-300"></i>
                                <span class="sidebar-label">Settings & Security</span>
                            </button>
                            <button onclick="clearAllCustomers()" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition" title="Delete All Customers">
                                <i class="fa-solid fa-trash-can w-5 text-center text-sm text-rose-500"></i>
                                <span class="sidebar-label">Delete All Data</span>
                            </button>
                        </nav>
                    </div>
                </div>
            </div>

            <!-- Bottom User & Lock button -->
            <div class="border-t border-slate-800 pt-4 px-1" id="sidebarFooter">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5 admin-profile-box">
                        <div class="w-8 h-8 rounded-xl bg-blue-600/30 border border-blue-500/40 flex items-center justify-center text-cyan-300 font-bold text-xs shrink-0" title="Admin">
                            ISP
                        </div>
                        <div class="sidebar-label">
                            <div class="text-xs font-bold text-white whitespace-nowrap" id="deskIspName">SonyBox Net</div>
                            <div class="text-[10px] text-slate-400 whitespace-nowrap">Admin Account</div>
                        </div>
                    </div>
                    <button onclick="lockApp()" class="lock-btn p-2 text-slate-400 hover:text-rose-400 transition" title="Lock Portal">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Desktop Main Workspace -->
        <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
            
            <!-- Desktop Topbar -->
            <header class="h-16 bg-white border-b border-slate-200 px-8 flex items-center justify-between sticky top-0 z-20 shadow-sm">
                
                <!-- Search bar & Area Filter on Desktop with Minimize/Maximize button -->
                <div class="flex items-center gap-3 w-1/2">
                    <button onclick="toggleSidebar()" id="sidebarToggleBtn" 
                            class="p-2.5 rounded-xl border border-slate-200 text-slate-600 hover:text-blue-600 hover:bg-blue-50/50 hover:border-blue-200 transition flex items-center justify-center shrink-0 shadow-sm" 
                            title="Sidebar Minimize / Maximize">
                        <i id="sidebarToggleIcon" class="fa-solid fa-bars-staggered text-sm"></i>
                    </button>

                    <div class="relative flex-1">
                        <input type="text" id="deskSearchInput" oninput="syncSearch(this.value)" 
                               placeholder="Search users, mobile, PPPoE username, ya ilaqa..." 
                               class="w-full bg-slate-50 border border-slate-300 rounded-xl py-2 pl-9 pr-4 text-xs font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    </div>

                    <select id="deskAreaFilter" onchange="syncArea(this.value)" 
                            class="bg-white border border-slate-300 text-xs font-semibold rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm shrink-0">
                        <option value="ALL">Tamam Ilaqay / Galiyan</option>
                    </select>
                </div>

                <!-- Action Buttons on Desktop -->
                <div class="flex items-center gap-2.5">
                    <!-- ☁️ CLOUD SYNC BUTTON (PC & MOBILE MERGE) -->
                    <button type="button" onclick="manualCloudSync(true)" id="cloudSyncBtnDesk" 
                            class="inline-flex items-center gap-2 px-3.5 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 rounded-xl text-xs font-bold transition shadow-sm" 
                            title="Click karein taake Mobile aur PC ka data 1-Click me merge aur live sync ho jaye">
                        <i id="cloudSyncIconDesk" class="fa-solid fa-cloud-arrow-up text-blue-600 text-xs"></i>
                        <span id="cloudSyncTextDesk">Live Synced</span>
                        <span id="cloudSyncDotDesk" class="w-2 h-2 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50"></span>
                    </button>

                    <button onclick="sendBulkReminderNotice()" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 rounded-xl text-xs font-bold transition">
                        <i class="fa-brands fa-whatsapp text-sm"></i>
                        <span>Send WhatsApp Reminders</span>
                    </button>

                    <button onclick="openModal('importModal')" class="inline-flex items-center gap-1.5 px-3 py-2 bg-cyan-50 text-cyan-700 hover:bg-cyan-100 border border-cyan-200 rounded-xl text-xs font-bold transition">
                        <i class="fa-solid fa-file-import text-xs"></i>
                        <span>Import</span>
                    </button>

                    <button onclick="openModal('exportModal')" class="inline-flex items-center gap-1.5 px-3 py-2 bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200 rounded-xl text-xs font-bold transition">
                        <i class="fa-solid fa-file-export text-xs"></i>
                        <span>Export</span>
                    </button>

                    <button onclick="openModal('addModal')" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-500/20 transition">
                        <i class="fa-solid fa-plus text-xs"></i>
                        <span>Naya User</span>
                    </button>

                    <div class="w-px h-6 bg-slate-200 mx-1"></div>

                    <button onclick="lockApp()" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-slate-600 hover:text-rose-600 transition">
                        <i class="fa-solid fa-lock text-xs"></i>
                        <span>Lock</span>
                    </button>
                </div>
            </header>

            <!-- Desktop Content Container -->
            <div class="p-8 space-y-6 max-w-7xl w-full mx-auto">
                
                <!-- Desktop Overview Section (KPI Cards + Chart, shown in Dashboard view) -->
                <div id="desktopOverviewSection" class="space-y-6">
                    <!-- Desktop KPI Metrics Cards (4 Columns) -->
                    <div class="grid grid-cols-4 gap-5">
                    
                    <!-- Card 1: Total Due (Net Remaining Baqi Bill - decreases as you receive payments) -->
                    <div class="bg-white p-5 rounded-2xl border border-rose-200/90 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between text-rose-600 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>Total Due (Kul Baqi Bill)</span>
                            <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                                <i class="fa-solid fa-hourglass-half text-sm"></i>
                            </div>
                        </div>
                        <div id="deskStatPending" class="text-2xl font-black text-rose-600">Rs 0</div>
                        <div class="mt-2 text-xs text-rose-700 flex items-center gap-1.5 font-bold">
                            <span id="deskStatPendingUsers">0</span> users baqi (Wasooli par minus hota hai)
                        </div>
                    </div>

                    <!-- Card 2: Wasool Shuda (Received Cash) -->
                    <div class="bg-white p-5 rounded-2xl border border-emerald-200/90 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between text-emerald-700 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>Wasool Shuda (Received)</span>
                            <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <i class="fa-solid fa-circle-check text-sm"></i>
                            </div>
                        </div>
                        <div id="deskStatPaid" class="text-2xl font-black text-emerald-600">Rs 0</div>
                        <div class="mt-2 text-xs text-emerald-700 flex items-center gap-1.5 font-bold">
                            <span id="deskStatPaidUsers">0</span> ada shuda (<span id="deskStatRate">0%</span> recovery)
                        </div>
                    </div>

                    <!-- Card 3: Total Monthly Billing Demand -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between text-slate-500 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>Kul Mahana Demand</span>
                            <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                <i class="fa-solid fa-file-invoice-dollar text-sm"></i>
                            </div>
                        </div>
                        <div id="deskStatTotal" class="text-2xl font-black text-slate-900">Rs 0</div>
                        <div class="mt-2 text-xs text-slate-500 flex items-center gap-1.5 font-semibold">
