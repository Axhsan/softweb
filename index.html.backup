                <!-- Option 3: Full JSON Backup -->
                <button type="button" onclick="exportJSONBackup()" 
                        class="w-full text-left p-3.5 rounded-2xl border border-slate-200 hover:border-blue-500 hover:bg-blue-50/30 transition flex items-center justify-between group">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg shadow-sm">
                            <i class="fa-solid fa-database"></i>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-900 group-hover:text-blue-700">Full System Backup (JSON)</div>
                            <div class="text-[11px] text-slate-500">Mukammal database file jo kisi bhi device par restore ho sake</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-cloud-arrow-down text-slate-400 group-hover:text-blue-600 text-sm"></i>
                </button>

                <!-- Option 4: Printable Field Sheet -->
                <button type="button" onclick="printFieldSheet()" 
                        class="w-full text-left p-3.5 rounded-2xl border border-slate-200 hover:border-purple-500 hover:bg-purple-50/30 transition flex items-center justify-between group">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center text-lg shadow-sm">
                            <i class="fa-solid fa-print"></i>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-900 group-hover:text-purple-700">Printable Recovery Sheet (A4 Print)</div>
                            <div class="text-[11px] text-slate-500">Field mein haath se tick lagane ke liye safha print karein</div>
                        </div>
                    </div>
                    <i class="fa-solid fa-arrow-up-right-from-square text-slate-400 group-hover:text-purple-600 text-sm"></i>
                </button>

            </div>

            <div class="pt-2">
                <button type="button" onclick="closeModal('exportModal')" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs transition">
                    Band Karein
                </button>
            </div>

        </div>
    </div>


    <!-- ============================================================ -->
    <!-- ⚡ CORE APPLICATION LOGIC                                    -->
    <!-- ============================================================ -->
    <script>
        const DEFAULT_CUSTOMERS = [
            { id: 1, name: "Chaudhry Akram", phone: "03001234567", userid: "akram_fiber", area: "Gali # 1, Purani Abadi", package: "20 Mbps Fiber", fee: 1800, status: "PAID", paidAt: "04 Nov, 11:30 AM" },
            { id: 2, name: "Haji Usman", phone: "03217654321", userid: "usman_gali2", area: "Gali # 2, Madina Chowk", package: "15 Mbps", fee: 1500, status: "PENDING", paidAt: null },
            { id: 3, name: "Muhammad Bilal", phone: "03459876543", userid: "bilal_bazar", area: "Main Bazar Shop # 14", package: "30 Mbps Commercial", fee: 2500, status: "PENDING", paidAt: null },
            { id: 4, name: "Master Tariq", phone: "03024567890", userid: "tariq_school", area: "Gali # 1, School Wali", package: "15 Mbps", fee: 1500, status: "PAID", paidAt: "04 Nov, 02:15 PM" },
            { id: 5, name: "Rana Zulfiqar", phone: "03335551234", userid: "rana_net", area: "Block B, Street 5", package: "25 Mbps Fiber", fee: 2000, status: "PENDING", paidAt: null },
            { id: 6, name: "Malik Shahzad", phone: "03129998877", userid: "shahzad_plaza", area: "Main Road Plaza", package: "50 Mbps Fiber", fee: 3500, status: "PENDING", paidAt: null },
            { id: 7, name: "Doctor Farooq", phone: "03014443322", userid: "farooq_clinic", area: "Madina Chowk", package: "20 Mbps", fee: 1800, status: "PAID", paidAt: "04 Nov, 09:40 AM" }
        ];

        // User requested: "Data many jo add kia usy sara delet karo or mujhy mera new data add karna hai"
        // Perform one-time full clean of previous bad imported data
        let stored = localStorage.getItem('rm_isp_customers');
        let customers = (stored !== null) ? JSON.parse(stored) : [];
        let currentFilterStatus = 'ALL';
        let currentSearchQuery = '';
        let currentAreaFilter = 'ALL';
        // Ensure default page size is 10 (auto-migrates if previously defaulted to 50)
        if (!localStorage.getItem('rm_pagesize_v10_migrated')) {
            localStorage.setItem('rm_pagesize_v10_migrated', 'true');
            if (!localStorage.getItem('rm_desktop_pagesize') || localStorage.getItem('rm_desktop_pagesize') === '50') {
                localStorage.setItem('rm_desktop_pagesize', '10');
            }
        }
        let desktopPageSize = localStorage.getItem('rm_desktop_pagesize') || '10';
        let desktopCurrentPage = 1;

        // Sanitize and load ISP details (Default: SonyBox)
        let rawName = (localStorage.getItem('rm_isp_name') || 'SonyBox').trim();
        if (rawName.includes('\n') || rawName.toLowerCase().includes('shukriya') || rawName.length > 35 || rawName.includes('RecoverMood')) {
            rawName = 'SonyBox';
            localStorage.setItem('rm_isp_name', rawName);
        }
        let ispName = rawName || 'SonyBox';
        let ispJazzcash = localStorage.getItem('rm_isp_jazzcash') || '';
        let ispHelpline = localStorage.getItem('rm_isp_helpline') || '';

        // Security PIN & Lock State
        let currentPin = localStorage.getItem('rm_isp_pin') || '1234';
        let isLockEnabled = localStorage.getItem('rm_isp_lock_enabled') !== 'false';

        toastr.options = { closeButton: true, progressBar: true, positionClass: "toast-top-center", timeOut: 2500 };

        // ----------------------------------------------------
        // ☁️ CENTRAL CLOUD SYNC & MERGE ENGINE (PC + MOBILE)
        // ----------------------------------------------------
        let lastSyncTimestamp = null;
        let isSyncInProgress = false;

        function getSyncApiUrl() {
            if (window.location.protocol === 'http:' || window.location.protocol === 'https:') {
                return `${window.location.origin}/api/data`;
            }
            return 'http://192.168.0.15:8080/api/data';
        }

        // Smart Bi-directional Merge: merges local & server customers without losing any data
        function mergeCustomerLists(localList, remoteList) {
            const map = new Map();
            const getKey = (c) => {
                if (!c) return '';
                if (c.id !== undefined && c.id !== null) return 'id:' + c.id;
                if (c.userid && String(c.userid).trim() && String(c.userid).trim() !== '-') return 'u:' + String(c.userid).trim().toLowerCase();
                if (c.phone && String(c.phone).trim()) {
                    const clean = String(c.phone).replace(/[^0-9]/g, '');
                    if (clean.length >= 7) return 'p:' + clean;
                }
                return 'n:' + String(c.name || '').trim().toLowerCase();
            };

            // 1. Map remote customers first
            (remoteList || []).forEach(c => {
                if (!c || !c.name) return;
                const k = getKey(c);
                if (k) map.set(k, { ...c });
            });

            // 2. Local customers take precedence for recent user actions
            (localList || []).forEach(local => {
                if (!local || !local.name) return;
                const k = getKey(local);
                if (!k) return;
                if (!map.has(k)) {
                    map.set(k, { ...local });
                } else {
                    const remote = map.get(k);
                    // Local customer state overrides remote (status, payments, due amounts, edits)
                    map.set(k, { ...remote, ...local });
                }
            });

            return Array.from(map.values());
        }

        async function syncWithServer(isManual = false, showNotification = false) {
            if (isSyncInProgress) return;
            isSyncInProgress = true;
            updateSyncUI('syncing');

            const apiUrl = getSyncApiUrl();
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 4000);

                const response = await fetch(apiUrl, {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    signal: controller.signal
                });
                clearTimeout(timeoutId);

                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const remoteData = await response.json();

                const remoteCustomers = remoteData.customers || [];
                const localCustomers = customers || [];
                const isLocalDirty = localStorage.getItem('rm_isp_dirty') === 'true';

                let needPush = false;
                let finalCustomers = [];

                if (remoteCustomers.length === 0 && localCustomers.length > 0) {
                    finalCustomers = localCustomers;
                    needPush = true;
                } else if (remoteCustomers.length > 0 && localCustomers.length === 0) {
                    finalCustomers = remoteCustomers;
                } else if (remoteCustomers.length > 0 && localCustomers.length > 0) {
                    if (isLocalDirty) {
                        finalCustomers = mergeCustomerLists(localCustomers, remoteCustomers);
                        needPush = true;
                    } else {
                        finalCustomers = remoteCustomers;
                    }
                } else {
                    finalCustomers = [];
                }

                customers = finalCustomers;
                saveToStorage(true); // save locally without re-pushing
                renderAllViews();

                if (remoteData.ispName && remoteData.ispName !== ispName && remoteData.ispName !== 'SonyBox') {
                    ispName = remoteData.ispName;
                    localStorage.setItem('rm_isp_name', ispName);
                    if (document.getElementById('deskIspName')) document.getElementById('deskIspName').textContent = ispName;
                    if (document.getElementById('mobDrawerIspName')) document.getElementById('mobDrawerIspName').textContent = ispName;
                }

                if (needPush) {
                    await pushDataToCloud(true);
                } else {
                    localStorage.setItem('rm_isp_dirty', 'false');
                }

                lastSyncTimestamp = remoteData.updatedAt || new Date().toISOString();
                updateSyncUI('synced');
                if (isManual || showNotification) {
                    toastr.success(`Auto-Synced! 🟢 (${customers.length} users live update)`);
                }
            } catch (err) {
                // file:/// fallback to localhost
                if (window.location.protocol === 'file:' && !apiUrl.includes('localhost')) {
                    try {
                        const altResp = await fetch('http://localhost:8080/api/data', { headers: { 'Accept': 'application/json' } });
                        if (altResp.ok) {
                            const altData = await altResp.json();
                            const isLocalDirty = localStorage.getItem('rm_isp_dirty') === 'true';
                            if (isLocalDirty && (altData.customers || []).length > 0 && customers.length > 0) {
                                customers = mergeCustomerLists(customers, altData.customers);
                            } else if ((altData.customers || []).length > 0) {
                                customers = altData.customers;
                            }
                            saveToStorage(true);
                            renderAllViews();
                            updateSyncUI('synced');
                            if (isManual || showNotification) toastr.success(`Auto-Synced! 🟢 (${customers.length} users live)`);
                            isSyncInProgress = false;
                            return;
                        }
                    } catch (e2) {}
                }
                updateSyncUI('offline');
                if (isManual) {
                    toastr.info("Server filhal offline hai. Local storage ka data mehfooz hai.");
                }
            } finally {
                isSyncInProgress = false;
            }
        }

        async function pushDataToCloud(silent = true) {
            isSyncInProgress = true;
            const apiUrl = getSyncApiUrl();
            const payload = {
                customers: customers,
                ispName: ispName,
                ispJazzcash: ispJazzcash,
                ispHelpline: ispHelpline,
                currentPin: currentPin,
                isLockEnabled: isLockEnabled,
                updatedAt: new Date().toISOString()
            };

            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 4000);

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload),
                    signal: controller.signal
                });
                clearTimeout(timeoutId);

                if (response.ok) {
                    updateSyncUI('synced');
                    localStorage.setItem('rm_isp_dirty', 'false');
                    lastSyncTimestamp = new Date().toISOString();
                    return true;
                } else {
                    updateSyncUI('offline');
                }
            } catch (err) {
                if (window.location.protocol === 'file:' && !apiUrl.includes('localhost')) {
                    try {
                        const r = await fetch('http://localhost:8080/api/data', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        if (r.ok) {
                            updateSyncUI('synced');
                            localStorage.setItem('rm_isp_dirty', 'false');
                            lastSyncTimestamp = new Date().toISOString();
                            return true;
                        }
                    } catch (e2) {}
                }
                updateSyncUI('offline');
            } finally {
                isSyncInProgress = false;
            }
            return false;
        }

        function updateSyncUI(status) {
            const deskText = document.getElementById('cloudSyncTextDesk');
            const deskDot = document.getElementById('cloudSyncDotDesk');
            const deskIcon = document.getElementById('cloudSyncIconDesk');
            const mobDot = document.getElementById('cloudSyncDotMob');
            const mobIcon = document.getElementById('cloudSyncIconMob');

            if (status === 'syncing') {
                if (deskText) deskText.textContent = "Syncing...";
                if (deskDot) deskDot.className = "w-2 h-2 rounded-full bg-amber-400 animate-ping";
                if (deskIcon) deskIcon.className = "fa-solid fa-rotate text-blue-600 text-xs animate-spin";
                if (mobDot) mobDot.className = "w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping";
                if (mobIcon) mobIcon.className = "fa-solid fa-rotate text-xs text-amber-300 animate-spin";
            } else if (status === 'synced') {
                if (deskText) deskText.textContent = "Live Synced";
                if (deskDot) deskDot.className = "w-2 h-2 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50";
                if (deskIcon) deskIcon.className = "fa-solid fa-cloud-arrow-up text-emerald-600 text-xs";
                if (mobDot) mobDot.className = "w-1.5 h-1.5 rounded-full bg-emerald-400";
                if (mobIcon) mobIcon.className = "fa-solid fa-cloud text-xs text-cyan-300";
            } else {
                if (deskText) deskText.textContent = "Offline (Local)";
                if (deskDot) deskDot.className = "w-2 h-2 rounded-full bg-slate-400";
                if (deskIcon) deskIcon.className = "fa-solid fa-cloud text-slate-400 text-xs";
                if (mobDot) mobDot.className = "w-1.5 h-1.5 rounded-full bg-slate-400";
                if (mobIcon) mobIcon.className = "fa-solid fa-cloud text-xs text-slate-300";
            }
        }

        function manualCloudSync(showToast = true) {
            syncWithServer(showToast);
        }

        // ----------------------------------------------------
        // ⚠️ UNIVERSAL CONFIRMATION POPUP SYSTEM
        // ----------------------------------------------------
        let pendingConfirmCallback = null;

        function showConfirm({ title, message, icon = 'fa-circle-question', iconBg = 'bg-blue-100 text-blue-600', btnText = 'Haan, Confirm Karein', btnClass = 'bg-blue-600 hover:bg-blue-700 text-white', onConfirm }) {
            document.getElementById('confirmTitle').textContent = title;
            document.getElementById('confirmMessage').textContent = message;

            const iconBox = document.getElementById('confirmIconBox');
            iconBox.className = `w-14 h-14 mx-auto rounded-2xl flex items-center justify-center text-2xl shadow-inner ${iconBg}`;
            document.getElementById('confirmIcon').className = `fa-solid ${icon}`;

            const btn = document.getElementById('confirmActionBtn');
            btn.textContent = btnText;
            btn.className = `w-full py-2.5 font-bold rounded-xl text-xs shadow-md transition ${btnClass}`;

            pendingConfirmCallback = onConfirm;
            document.getElementById('confirmModal').classList.remove('hidden');
        }

        function closeConfirmModal() {
            pendingConfirmCallback = null;
            document.getElementById('confirmModal').classList.add('hidden');
        }

        function executeConfirmAction() {
            if (typeof pendingConfirmCallback === 'function') {
                const cb = pendingConfirmCallback;
                pendingConfirmCallback = null;
                document.getElementById('confirmModal').classList.add('hidden');
                cb();
            } else {
                closeConfirmModal();
            }
        }

        function sendWhatsAppMessage(id, isReceipt) {
            const customer = customers.find(c => c.id === id);
            if (!customer) return;

            const actionName = isReceipt ? 'Parchi (Payment Receipt)' : 'Bill Reminder';
            showConfirm({
                title: `WhatsApp ${actionName} Bhejein?`,
                message: `Kya aap ${customer.name} ko WhatsApp par ${actionName} bhejna chahte hain?`,
                icon: 'fa-brands fa-whatsapp text-2xl',
                iconBg: 'bg-emerald-100 text-emerald-600',
                btnText: 'Haan, WhatsApp Kholein',
                btnClass: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/25',
                onConfirm: () => {
                    let formattedPhone = customer.phone.replace(/[^0-9]/g, '');
                    let waNumber = formattedPhone;
                    if (waNumber.startsWith('0')) waNumber = '92' + waNumber.substring(1);
                    const msg = isReceipt ? buildWhatsAppReceipt(customer) : buildWhatsAppReminder(customer);
                    window.open(`https://wa.me/${waNumber}?text=${msg}`, '_blank');
                }
            });
        }

        // Clean & formatted WhatsApp Message Generators (SonyBox - No Package)
        function buildWhatsAppReminder(c) {
            const currentMonth = "November 2026";
            const due = (c.dueAmount !== undefined) ? Number(c.dueAmount) : (c.status === 'PAID' ? 0 : Number(c.fee));
            let msg = `Assalam-o-Alaikum ${c.name} sb!\n\n` +
                      `*SonyBox* ki taraf se aapka *${currentMonth}* ka internet bill baqi (Due) hai:\n\n` +
                      `💰 *Baqi Raqam (Pending Due):* Rs. ${Number(due).toLocaleString()}\n`;

            if (c.paidAmount && Number(c.paidAmount) > 0) {
                msg += `💵 *Pehle Ada Shuda:* Rs. ${Number(c.paidAmount).toLocaleString()}\n` +
                       `📊 *Kul Mahana Bill:* Rs. ${Number(c.fee).toLocaleString()}\n`;
            }

            msg += `⚠️ *Status:* ${c.status === 'PARTIAL' ? 'Baqi Qist (Partial Due)' : 'Baqi (Pending Due)'}\n\n`;

            if (c.expireDate) {
                msg += `📅 *Expiry Date:* ${c.expireDate}\n\n`;
            }

            msg += `Baraye meherbani apna bill jald ada karein taake connection me koi masla na aye.\n\n`;

            if (ispJazzcash) {
                msg += `💳 *JazzCash / EasyPaisa:* ${ispJazzcash}\n`;
            }
            if (ispHelpline) {
                msg += `📞 *Helpline / Rabta:* ${ispHelpline}\n`;
            }

            msg += `\nShukriya!\n*SonyBox*`;
            return encodeURIComponent(msg);
        }

        function buildWhatsAppReceipt(c, recentPaidAmount = null) {
            const currentMonth = "November 2026";
            const amountReceived = recentPaidAmount !== null ? recentPaidAmount : (c.paidAmount || c.fee);
            const remainingDue = (c.dueAmount !== undefined) ? Number(c.dueAmount) : (c.status === 'PAID' ? 0 : Number(c.fee));

            let msg = `Assalam-o-Alaikum ${c.name} sb!\n\n` +
                      `Shukriya! Aapka *${currentMonth}* ka internet bill receive ho gaya hai:\n\n` +
                      `💵 *Wasool Shuda Rakam:* Rs. ${Number(amountReceived).toLocaleString()}\n`;

            if (remainingDue > 0) {
                msg += `⚠️ *Baqi Raqam (Pending Due):* Rs. ${Number(remainingDue).toLocaleString()}\n` +
                       `📊 *Kul Mahana Bill:* Rs. ${Number(c.fee).toLocaleString()}\n` +
                       `⏳ *Status:* Partial Payment (Aadhi Wasooli)\n\n`;
            } else {
                msg += `✅ *Status:* PAID (Wasool Shuda)\n\n`;
            }

            if (c.receiptId) {
                msg += `🧾 *Receipt ID:* ${c.receiptId}\n`;
            }
            if (c.cashType) {
                msg += `💳 *Payment Mode:* ${c.cashType}\n`;
            }

            msg += `📅 *Tareekh:* ${c.paidAt || 'Aaj'}\n\n`;

            if (c.expireDate) {
                msg += `⏳ *Next Expiry:* ${c.expireDate}\n\n`;
            }

            if (ispHelpline) {
                msg += `📞 *Helpline:* ${ispHelpline}\n`;
            }

            msg += `\n*SonyBox* ka intekhab karne ka shukriya!`;
            return encodeURIComponent(msg);
        }

        // ----------------------------------------------------
        // 🔒 LOCK SCREEN / PIN FUNCTIONS
        // ----------------------------------------------------
        function checkLockStatus() {
            const isUnlocked = sessionStorage.getItem('rm_isp_unlocked') === 'true';
            const lockScreen = document.getElementById('lockScreen');

            if (isLockEnabled && !isUnlocked) {
                lockScreen.classList.remove('hidden');
                document.getElementById('pinInput').value = '';
                document.getElementById('lockErrorMsg').textContent = '';
                document.getElementById('pinInput').focus();
            } else {
                lockScreen.classList.add('hidden');
            }
        }

        function pressPin(digit) {
            const input = document.getElementById('pinInput');
            if (input.value.length < 12) {
                input.value += digit;
            }
            document.getElementById('lockErrorMsg').textContent = '';
            if (input.value.length === currentPin.length) {
                setTimeout(checkUnlock, 150);
            }
        }

        function clearPin() {
            document.getElementById('pinInput').value = '';
            document.getElementById('lockErrorMsg').textContent = '';
        }

        function autoFillPin() {
            document.getElementById('pinInput').value = currentPin;
            checkUnlock();
        }

        function checkUnlock() {
            const entered = document.getElementById('pinInput').value;
            const card = document.getElementById('lockCard');
            const errorMsg = document.getElementById('lockErrorMsg');

            if (entered === currentPin) {
                sessionStorage.setItem('rm_isp_unlocked', 'true');
                document.getElementById('lockScreen').classList.add('hidden');
                document.getElementById('pinInput').value = '';
                errorMsg.textContent = '';
                toastr.success("Portal Unlocked! Auto-Syncing... 🟢");
                // 🔄 Immediate Auto-Sync on Login
                syncWithServer(false, true);
            } else {
                errorMsg.textContent = "Ghalat PIN! Dobara try karein.";
                card.classList.add('shake');
                setTimeout(() => card.classList.remove('shake'), 400);
                document.getElementById('pinInput').value = '';
            }
        }

        // Listen for Enter key on Lock Screen
        document.getElementById('pinInput').addEventListener('keyup', function(e) {
            if (e.key === 'Enter') checkUnlock();
        });

        function lockApp() {
            showConfirm({
                title: 'App Lock Karein?',
                message: 'Kya aap app / portal ko foran lock karna chahte hain? Khulne par dobara PIN dalna padega.',
                icon: 'fa-lock',
                iconBg: 'bg-slate-100 text-slate-800',
                btnText: 'Haan, Lock Karein',
                btnClass: 'bg-slate-900 hover:bg-slate-800 text-white shadow-slate-900/25',
                onConfirm: () => {
                    sessionStorage.removeItem('rm_isp_unlocked');
                    toastr.info("App / Portal Lock ho gaya!");
                    checkLockStatus();
                }
            });
        }

        function toggleLockFeature() {
            const toggle = document.getElementById('lockEnabledToggle');
            isLockEnabled = toggle.checked;
            localStorage.setItem('rm_isp_lock_enabled', isLockEnabled ? 'true' : 'false');
            toastr.info(`PIN Protection ${isLockEnabled ? 'ENABLED (Chalu)' : 'DISABLED (Band)'}`);
        }

        function updatePin() {
            const newPin = document.getElementById('newPinInput').value.trim();
            if (newPin.length < 3) {
                toastr.error("PIN kam az kam 3 ya 4 digits ka hona chahiye.");
                return;
            }
            currentPin = newPin;
            localStorage.setItem('rm_isp_pin', currentPin);
            document.getElementById('newPinInput').value = '';
            toastr.success(`Naya PIN save ho gaya: ${newPin}`);
        }

        function updateIspName() {
            let name = document.getElementById('ispNameInput').value.trim();
            if (name.includes('\n') || name.toLowerCase().includes('shukriya') || name.length > 35) {
                name = 'SonyBox';
                document.getElementById('ispNameInput').value = name;
            }
            ispName = name;
            localStorage.setItem('rm_isp_name', ispName);
            document.getElementById('deskIspName').textContent = ispName;
            toastr.success("ISP Name update ho gaya!");
            renderAllViews();
        }

        function updatePaymentDetails() {
            ispJazzcash = document.getElementById('ispJazzcashInput').value.trim();
            ispHelpline = document.getElementById('ispHelplineInput').value.trim();
            localStorage.setItem('rm_isp_jazzcash', ispJazzcash);
            localStorage.setItem('rm_isp_helpline', ispHelpline);
            toastr.success("WhatsApp payment details save ho gayin!");
            renderAllViews();
        }

        // ----------------------------------------------------
        // SEARCH & FILTER SYNCHRONIZATION (PC & MOBILE)
        // ----------------------------------------------------
        function syncSearch(val) {
            currentSearchQuery = val.toLowerCase().trim();
            document.getElementById('searchInput').value = val;
            document.getElementById('deskSearchInput').value = val;
            document.getElementById('clearBtn').classList.toggle('hidden', val === '');
            desktopCurrentPage = 1;
            renderAllViews();
        }

        function syncArea(val) {
            currentAreaFilter = val;
            document.getElementById('areaFilter').value = val;
            document.getElementById('deskAreaFilter').value = val;
            desktopCurrentPage = 1;
            renderAllViews();
        }

        function clearSearch() {
            syncSearch('');
        }

        function clearAllCustomers() {
            if (customers.length === 0) {
                toastr.info("Data pehle se hi khali hai.");
                return;
            }
            showConfirm({
                title: 'Tamam Data Mukammal Delete Karein?',
                message: `Kya aap waqai tamam (${customers.length}) customers ko delete karna chahte hain? Iske baad aap apna naya data fresh import kar sakenge.`,
                icon: 'fa-trash-can',
                iconBg: 'bg-rose-100 text-rose-600',
                btnText: 'Haan, Sab Delete Karein',
                btnClass: 'bg-rose-600 hover:bg-rose-700 text-white shadow-rose-500/25',
                onConfirm: () => {
                    customers = [];
                    saveToStorage();
                    renderAllViews();
                    toastr.success("Tamam data kamyabi se delete ho gaya! Ab naya data add karein.");
                }
            });
        }

        // ----------------------------------------------------
        // 📄 DEDICATED PAGE NAVIGATION SYSTEM (SPA VIEWS)
        // ----------------------------------------------------
        let currentAppPage = 'dashboard'; // Active page view: 'dashboard' | 'allCustomers' | 'defaultUsers' | 'paidCustomers'

        function openPage(pageName, silent = false) {
            currentAppPage = pageName;
            desktopCurrentPage = 1;

            // Map page to filter status: Dashboard shows ONLY unpaid/due recovery; Paid users are hidden!
            if (pageName === 'allCustomers') {
                currentFilterStatus = 'ALL';
            } else if (pageName === 'defaultUsers') {
                currentFilterStatus = 'PENDING';
            } else if (pageName === 'paidCustomers') {
                currentFilterStatus = 'PAID';
            } else if (pageName === 'dashboard') {
                currentFilterStatus = 'PENDING'; // Paid users excluded from dashboard!
            }

            // 1. Desktop Sections Visibility
            const deskOverview = document.getElementById('desktopOverviewSection');
            const deskHeader = document.getElementById('desktopDedicatedPageHeader');

            if (pageName === 'dashboard') {
                if (deskOverview) deskOverview.classList.remove('hidden');
                if (deskHeader) deskHeader.classList.add('hidden');
            } else {
                if (deskOverview) deskOverview.classList.add('hidden');
                if (deskHeader) deskHeader.classList.remove('hidden');
            }

            // 2. Mobile Sections Visibility
            const mobKpi = document.getElementById('mobileKpiSection');
            const mobPageNavBar = document.getElementById('mobilePageNavBar');

            if (pageName === 'dashboard') {
                if (mobKpi) mobKpi.classList.remove('hidden');
                if (mobPageNavBar) mobPageNavBar.classList.add('hidden');
            } else {
                if (mobKpi) mobKpi.classList.add('hidden');
                if (mobPageNavBar) mobPageNavBar.classList.remove('hidden');
            }

            // 3. Update Desktop Dedicated Page Header Details
            updateDedicatedPageHeaders(pageName);

            // 4. Update Navigation active states across Desktop Sidebar, Mobile Drawer & Mobile Bottom Bar
            updateAppNavStates(pageName);

            // 5. Update Table and Mobile filter tabs
            updateTabBadges(currentFilterStatus);

            // 6. Update URL Hash without jumping
            const hash = pageName === 'defaultUsers' ? 'default-users' : (pageName === 'dashboard' ? 'dashboard' : (pageName === 'paidCustomers' ? 'paid-customers' : 'all-customers'));
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, null, '#' + hash);
            }

            // 7. Render customers
            renderAllViews();

            // 8. Notifications
            if (!silent) {
                if (pageName === 'allCustomers') {
                    toastr.info("👥 All Customers Directory (Tamam users).");
                } else if (pageName === 'defaultUsers') {
                    toastr.info("⚠️ Default Users Page (Sirf baqi fees wale users).");
                } else if (pageName === 'paidCustomers') {
                    toastr.success("📁 Paid Users Folder khul gaya (Tamam ada shuda bills).");
                } else if (pageName === 'dashboard') {
                    toastr.info("📊 Dashboard (Sirf baqi recovery - Paid chupa diye gaye hain).");
                }
            }

            // Smooth scroll to main table/cards if switching to customers
            if (pageName !== 'dashboard') {
                scrollToCustomers();
            }
        }

        function switchDedicatedPage() {
            if (currentAppPage === 'paidCustomers') {
                openPage('dashboard');
            } else if (currentAppPage === 'defaultUsers') {
                openPage('paidCustomers');
            } else {
                openPage('defaultUsers');
            }
        }

        function updateDedicatedPageHeaders(pageName) {
            const titleEl = document.getElementById('pageHeaderTitle');
            const subtitleEl = document.getElementById('pageHeaderSubtitle');
            const badgeEl = document.getElementById('pageHeaderBadge');
            const switchBtn = document.getElementById('pageHeaderSwitchBtn');
            const switchIcon = document.getElementById('pageHeaderSwitchIcon');
            const switchText = document.getElementById('pageHeaderSwitchBtnText');

            const mobBadge = document.getElementById('mobilePageBadge');
            const mobSwitchText = document.getElementById('mobilePageSwitchText');

            const total = customers.length;
            const pending = customers.filter(c => c.status !== 'PAID').length;
            const paid = customers.filter(c => c.status === 'PAID').length;

            if (pageName === 'allCustomers') {
                if (titleEl) titleEl.innerHTML = `<i class="fa-solid fa-users text-blue-600 mr-1.5"></i> All Customers Directory`;
                if (subtitleEl) subtitleEl.textContent = "Registered ISP customers ki mukammal live directory";
                if (badgeEl) {
                    badgeEl.textContent = `${total} Users`;
                    badgeEl.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800";
                }
                if (switchText) switchText.textContent = "Paid Users Folder";
                if (switchIcon) switchIcon.className = "fa-solid fa-folder-closed";
                if (switchBtn) switchBtn.className = "px-3.5 py-2 border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm";

                if (mobBadge) mobBadge.textContent = `All Users (${total})`;
                if (mobSwitchText) mobSwitchText.textContent = "Paid Folder";
            } else if (pageName === 'defaultUsers') {
                if (titleEl) titleEl.innerHTML = `<i class="fa-solid fa-user-xmark text-rose-600 mr-1.5"></i> Default Users Page`;
                if (subtitleEl) subtitleEl.textContent = "Sirf un users ki live list jin ka bill baqi hai (Pending Defaulters)";
                if (badgeEl) {
                    badgeEl.textContent = `${pending} Baqi Users`;
                    badgeEl.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300";
                }
                if (switchText) switchText.textContent = "Paid Users Folder";
                if (switchIcon) switchIcon.className = "fa-solid fa-folder-closed";
                if (switchBtn) switchBtn.className = "px-3.5 py-2 border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm";

                if (mobBadge) mobBadge.textContent = `Default Users (${pending})`;
                if (mobSwitchText) mobSwitchText.textContent = "Paid Folder";
            } else if (pageName === 'paidCustomers') {
                if (titleEl) titleEl.innerHTML = `<i class="fa-solid fa-folder-closed text-emerald-600 mr-2"></i> Paid Users Folder (ادا شدہ یوزرز)`;
                if (subtitleEl) subtitleEl.textContent = "Wasool shuda bills aur mukammal paid customers ka alag folder";
                if (badgeEl) {
                    badgeEl.textContent = `${paid} Paid Users`;
                    badgeEl.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                }
                if (switchText) switchText.textContent = "Dashboard (Baqi Users)";
                if (switchIcon) switchIcon.className = "fa-solid fa-chart-pie";
                if (switchBtn) switchBtn.className = "px-3.5 py-2 border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm";

                if (mobBadge) mobBadge.textContent = `Paid Users (${paid})`;
                if (mobSwitchText) mobSwitchText.textContent = "Dashboard";
            }
        }

        function updateAppNavStates(pageName) {
            // 1. Desktop sidebar buttons
            const navMapDesk = {
                dashboard: document.getElementById('navBtnDashboard'),
                allCustomers: document.getElementById('navBtnAll'),
                defaultUsers: document.getElementById('navBtnPending'),
                paidCustomers: document.getElementById('navBtnPaid')
            };

            Object.keys(navMapDesk).forEach(k => {
                const el = navMapDesk[k];
                if (!el) return;
                el.classList.remove('bg-blue-600', 'bg-rose-600', 'bg-emerald-600', 'text-white');
                el.classList.add('text-slate-400');
            });

            if (pageName === 'dashboard' && navMapDesk.dashboard) {
                navMapDesk.dashboard.classList.add('bg-blue-600', 'text-white');
                navMapDesk.dashboard.classList.remove('text-slate-400');
            } else if (pageName === 'allCustomers' && navMapDesk.allCustomers) {
                navMapDesk.allCustomers.classList.add('bg-blue-600', 'text-white');
                navMapDesk.allCustomers.classList.remove('text-slate-400');
            } else if (pageName === 'defaultUsers' && navMapDesk.defaultUsers) {
                navMapDesk.defaultUsers.classList.add('bg-rose-600', 'text-white');
                navMapDesk.defaultUsers.classList.remove('text-slate-400');
            } else if (pageName === 'paidCustomers' && navMapDesk.paidCustomers) {
                navMapDesk.paidCustomers.classList.add('bg-emerald-600', 'text-white');
                navMapDesk.paidCustomers.classList.remove('text-slate-400');
            }

            // 2. Mobile side drawer buttons
            const navMapMob = {
                dashboard: document.getElementById('mobNavBtnDashboard'),
                allCustomers: document.getElementById('mobNavBtnAll'),
                defaultUsers: document.getElementById('mobNavBtnPending'),
                paidCustomers: document.getElementById('mobNavBtnPaid')
            };

            Object.keys(navMapMob).forEach(k => {
                const el = navMapMob[k];
                if (!el) return;
                el.classList.remove('bg-blue-600', 'bg-rose-600', 'bg-emerald-600', 'text-white');
                el.classList.add('text-slate-400');
            });

            if (pageName === 'dashboard' && navMapMob.dashboard) {
                navMapMob.dashboard.classList.add('bg-blue-600', 'text-white');
                navMapMob.dashboard.classList.remove('text-slate-400');
            } else if (pageName === 'allCustomers' && navMapMob.allCustomers) {
                navMapMob.allCustomers.classList.add('bg-blue-600', 'text-white');
                navMapMob.allCustomers.classList.remove('text-slate-400');
            } else if (pageName === 'defaultUsers' && navMapMob.defaultUsers) {
                navMapMob.defaultUsers.classList.add('bg-rose-600', 'text-white');
                navMapMob.defaultUsers.classList.remove('text-slate-400');
            } else if (pageName === 'paidCustomers' && navMapMob.paidCustomers) {
                navMapMob.paidCustomers.classList.add('bg-emerald-600', 'text-white');
                navMapMob.paidCustomers.classList.remove('text-slate-400');
            }

            // 3. Mobile bottom nav buttons
            const botDash = document.getElementById('mobBottomNavDash');
            const botPaid = document.getElementById('mobBottomNavPaid');
            const botPending = document.getElementById('mobBottomNavPending');

            [botDash, botPaid, botPending].forEach(b => {
                if (b) {
                    b.classList.remove('text-blue-600', 'text-emerald-600', 'text-rose-600', 'font-bold');
                    b.classList.add('text-slate-500');
                }
            });

            if (pageName === 'dashboard' && botDash) {
                botDash.classList.add('text-blue-600', 'font-bold');
                botDash.classList.remove('text-slate-500');
            } else if (pageName === 'paidCustomers' && botPaid) {
                botPaid.classList.add('text-emerald-600', 'font-bold');
                botPaid.classList.remove('text-slate-500');
            } else if (pageName === 'defaultUsers' && botPending) {
                botPending.classList.add('text-rose-600', 'font-bold');
                botPending.classList.remove('text-slate-500');
            }
        }

        function updateTabBadges(status) {
            // 1. Mobile top tabs
            document.querySelectorAll('#tabAll, #tabPending, #tabPaid').forEach(b => {
                b.classList.remove('active-tab', 'font-bold');
            });
            const mobActive = (currentAppPage === 'dashboard' || status === 'PENDING') ? 'tabPending' : (status === 'PAID' ? 'tabPaid' : 'tabAll');
            const mobBtn = document.getElementById(mobActive);
            if (mobBtn) mobBtn.classList.add('active-tab', 'font-bold');

            // 2. Desktop table header tabs
            ['tableTabAll', 'tableTabPending', 'tableTabPaid'].forEach(id => {
                const b = document.getElementById(id);
                if (b) {
                    b.classList.remove('active-tab', 'bg-blue-600', 'bg-rose-600', 'bg-emerald-600', 'text-white');
                    b.classList.add('text-slate-600');
                }
            });
            const filterBadge = document.getElementById('currentFilterBadge');

            const paidCount = customers.filter(c => c.status === 'PAID').length;
            const pendingCount = customers.filter(c => c.status !== 'PAID').length;

            if (currentAppPage === 'dashboard') {
                const b = document.getElementById('tableTabPending');
                if (b) {
                    b.classList.add('active-tab', 'bg-rose-600', 'text-white');
                    b.classList.remove('text-slate-600');
                }
                if (filterBadge) {
                    filterBadge.innerHTML = `<span class="flex items-center gap-1.5"><i class="fa-solid fa-hourglass-half text-rose-500"></i> Dashboard: ${pendingCount} Baqi Recovery &nbsp;|&nbsp; <button type="button" onclick="openPage('paidCustomers')" class="text-emerald-700 hover:text-emerald-900 font-extrabold underline inline-flex items-center gap-1"><i class="fa-solid fa-folder-closed"></i> ${paidCount} Paid Users Folder Me Hain</button></span>`;
                    filterBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-300";
                }
            } else if (status === 'ALL') {
                const b = document.getElementById('tableTabAll');
                if (b) {
                    b.classList.add('active-tab', 'bg-blue-600', 'text-white');
                    b.classList.remove('text-slate-600');
                }
                if (filterBadge) {
                    filterBadge.textContent = "All Customers (Tamam Users)";
                    filterBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-blue-100 text-blue-800";
                }
            } else if (status === 'PENDING') {
                const b = document.getElementById('tableTabPending');
                if (b) {
                    b.classList.add('active-tab', 'bg-rose-600', 'text-white');
                    b.classList.remove('text-slate-600');
                }
                if (filterBadge) {
                    filterBadge.textContent = "Default Users (Fees Baqi)";
                    filterBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-800 border border-rose-200";
                }
            } else if (status === 'PAID') {
                const b = document.getElementById('tableTabPaid');
                if (b) {
                    b.classList.add('active-tab', 'bg-emerald-600', 'text-white');
                    b.classList.remove('text-slate-600');
                }
                if (filterBadge) {
                    filterBadge.innerHTML = `<i class="fa-solid fa-folder-closed mr-1"></i> Paid Users Folder (${paidCount} Ada Shuda)`;
                    filterBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                }
            }
        }

        // Bridge filterStatus to openPage
        function filterStatus(status) {
            if (status === 'PENDING') {
                openPage('defaultUsers');
            } else if (status === 'PAID') {
                openPage('paidCustomers');
            } else {
                openPage('allCustomers');
            }
        }

        // ----------------------------------------------------
        // RENDERING VIEWS (DESKTOP TABLE + MOBILE CARDS)
        // ----------------------------------------------------
        function saveToStorage(skipRemotePush = false) {
            localStorage.setItem('rm_isp_customers', JSON.stringify(customers));
            localStorage.setItem('rm_isp_name', ispName);
            localStorage.setItem('rm_isp_jazzcash', ispJazzcash);
            localStorage.setItem('rm_isp_helpline', ispHelpline);
            updateStats();
            if (!skipRemotePush) {
                localStorage.setItem('rm_isp_dirty', 'true');
                pushDataToCloud(true);
            }
        }

        function getFilteredCustomers() {
            return customers.filter(c => {
                let matchStatus = true;
                if (currentFilterStatus === 'PAID') {
                    matchStatus = (c.status === 'PAID');
                } else if (currentFilterStatus === 'PENDING') {
                    matchStatus = (c.status !== 'PAID');
                }
                const matchArea = (currentAreaFilter === 'ALL') || (c.area === currentAreaFilter);
                const q = currentSearchQuery.toLowerCase();
                const matchSearch = !q || (
                    (c.name && c.name.toLowerCase().includes(q)) || 
                    (c.phone && c.phone.includes(q)) || 
                    (c.userid && c.userid.toLowerCase().includes(q)) ||
                    (c.area && c.area.toLowerCase().includes(q)) ||
                    (c.package && c.package.toLowerCase().includes(q)) ||
                    (c.password && c.password.toLowerCase().includes(q)) ||
                    (c.expireDate && c.expireDate.toLowerCase().includes(q))
                );
                return matchStatus && matchArea && matchSearch;
            });
        }

        function renderAllViews() {
            populateAreas();
            const filtered = getFilteredCustomers();
            renderMobileCards(filtered);
            renderDesktopTable(filtered);
            updateStats();
        }

        // 1. MOBILE CARDS RENDER
        function renderMobileCards(filtered) {
            const listEl = document.getElementById('customerList');
            const emptyState = document.getElementById('emptyState');

            if (filtered.length === 0) {
                listEl.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            listEl.innerHTML = filtered.map(c => {
                const isPaid = c.status === 'PAID';
                const isPartial = c.status === 'PARTIAL';
                const currentDue = (c.dueAmount !== undefined) ? Number(c.dueAmount) : (isPaid ? 0 : Number(c.fee));

                return `
                <div class="bg-white rounded-2xl p-4 border ${isPaid ? 'border-emerald-200 bg-emerald-50/20' : (isPartial ? 'border-amber-200 bg-amber-50/20 shadow-sm' : 'border-slate-200/90 shadow-sm')} transition">
                    <div class="flex items-center justify-between gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="text-sm font-extrabold text-slate-900 cursor-pointer hover:text-blue-600 transition" onclick="openHistoryModal(${c.id})">${c.name}</h3>
                                ${c.userid ? `<span class="text-[10px] bg-slate-100 font-mono text-slate-700 px-1.5 py-0.5 rounded font-bold">${c.userid}</span>` : ''}
                                ${c.password ? `<span class="text-[10px] bg-blue-50 text-blue-700 font-mono px-1.5 py-0.5 rounded font-semibold border border-blue-200/60" title="PPPoE Password"><i class="fa-solid fa-key text-[8px] mr-0.5"></i>${c.password}</span>` : ''}
                                <button type="button" onclick="openHistoryModal(${c.id})" class="text-[10px] text-blue-700 bg-blue-50 hover:bg-blue-100 font-bold px-1.5 py-0.5 rounded-md border border-blue-200/80 inline-flex items-center gap-1 transition" title="Paid History Dekhein">
                                    <i class="fa-solid fa-clock-rotate-left text-[9px]"></i> History
                                </button>
                            </div>
                            <div class="text-[11px] text-slate-500 flex items-center gap-1.5 mt-0.5">
                                <i class="fa-solid fa-location-dot text-rose-500 text-[10px]"></i>
                                <span>${c.area}</span>
                            </div>
                        </div>

                        <!-- Middle: Baqi Rakam (Centered) -->
                        ${isPartial ? `
                            <div class="text-center px-1 shrink-0">
                                <div class="inline-flex flex-col items-center justify-center bg-rose-50 border border-rose-200 px-3 py-1 rounded-xl shadow-xs">
                                    <span class="text-[9px] font-extrabold text-rose-500 uppercase tracking-wider leading-none">Baqi Rakam</span>
                                    <span class="text-xs sm:text-sm font-black text-rose-700 leading-tight mt-0.5">Rs ${currentDue.toLocaleString()}</span>
                                </div>
                            </div>
                        ` : ''}

                        <div class="text-right shrink-0">
                            <span class="text-base font-black ${isPaid ? 'text-emerald-600' : 'text-slate-900'} block">
                                Rs ${c.fee.toLocaleString()}
                            </span>
                            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full ${
                                isPaid ? 'bg-emerald-100 text-emerald-800' : 
                                (isPartial ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-rose-100 text-rose-700')
                            }">
                                <i class="fa-solid ${isPaid ? 'fa-circle-check text-emerald-600' : (isPartial ? 'fa-hourglass-half text-amber-600' : 'fa-hourglass-start')}"></i>
                                ${isPaid ? 'Wasool' : (isPartial ? 'Partial Paid' : 'Baqi Bill')}
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-[11px] text-slate-500 border-t border-slate-100 mt-2.5 pt-2 flex-wrap gap-1">
                        <span class="flex items-center gap-1">
                            <i class="fa-solid fa-wifi text-blue-500"></i> ${c.package || 'Internet Package'}
                        </span>
                        ${isPartial ? `<span class="text-[10px] text-emerald-700 font-bold bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-lg"><i class="fa-solid fa-check mr-1 text-emerald-600"></i>Wasool: Rs ${Number(c.paidAmount || 0).toLocaleString()}</span>` : ''}
                        <div class="flex items-center gap-2">
                            ${c.expireDate ? `<span class="text-[10px] text-amber-600 font-semibold flex items-center gap-1 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200/60"><i class="fa-regular fa-calendar-xmark text-[9px]"></i> Exp: ${c.expireDate}</span>` : ''}
                            ${isPaid ? `<span class="text-[10px] text-emerald-700 font-semibold"><i class="fa-solid fa-clock"></i> ${c.paidAt || 'Paid'}</span>` : ''}
                        </div>
                    </div>

                    <div class="grid grid-cols-12 gap-1.5 mt-3 pt-2.5 border-t border-slate-100">
                        ${isPaid ? `
                            <button onclick="revertToUnpaid(${c.id})" 
                                    class="col-span-6 py-2 px-3 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition shadow-sm bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                <span>Unpaid</span>
                            </button>
                            <button type="button" onclick="sendWhatsAppMessage(${c.id}, true)" 
                               class="col-span-4 py-2 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition">
                                <i class="fa-brands fa-whatsapp text-sm"></i>
                                <span>Parchi</span>
                            </button>
                        ` : (isPartial ? `
                            <button onclick="openPaymentModalById(${c.id})" 
                                    class="col-span-4 py-2 px-1.5 rounded-xl font-bold text-xs flex items-center justify-center gap-1 bg-amber-600 hover:bg-amber-700 active:scale-98 text-white shadow-sm shadow-amber-500/20 transition">
                                <i class="fa-solid fa-coins text-[10px]"></i>
                                <span>Baqi Wasool</span>
                            </button>
                            <button onclick="revertToUnpaid(${c.id})" 
                                    class="col-span-3 py-2 px-1 rounded-xl font-bold text-xs flex items-center justify-center gap-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition">
                                <i class="fa-solid fa-arrow-rotate-left text-[10px]"></i>
                                <span>Unpaid</span>
                            </button>
                            <button type="button" onclick="sendWhatsAppMessage(${c.id}, false)" 
                               class="col-span-3 py-2 px-1 rounded-xl font-bold text-xs flex items-center justify-center gap-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition">
                                <i class="fa-brands fa-whatsapp text-xs"></i>
                                <span>Reminder</span>
                            </button>
                        ` : `
                            <button onclick="openPaymentModalById(${c.id})" 
                                    class="col-span-6 py-2 px-3 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition shadow-sm bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white shadow-emerald-500/20">
                                <i class="fa-solid fa-check-double"></i>
                                <span>Wasool Karein</span>
                            </button>
                            <button type="button" onclick="sendWhatsAppMessage(${c.id}, false)" 
                               class="col-span-4 py-2 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition">
                                <i class="fa-brands fa-whatsapp text-xs"></i>
                                <span>Reminder</span>
                            </button>
                        `)}

                        <a href="tel:${c.phone}" 
                           class="col-span-1 py-2 rounded-xl font-bold text-xs flex items-center justify-center bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 transition" title="Call">
                            <i class="fa-solid fa-phone"></i>
                        </a>

                        <button onclick="editCustomer(${c.id})" 
                                class="col-span-1 py-2 rounded-xl font-bold text-xs flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 transition" title="Edit">
                            <i class="fa-solid fa-pen text-slate-500"></i>
                        </button>
                    </div>
                </div>
                `;
            }).join('');
        }

        function changeDesktopPageSize(newSize) {
            desktopPageSize = newSize;
            localStorage.setItem('rm_desktop_pagesize', newSize);
            desktopCurrentPage = 1;
            renderAllViews();
        }

        function changeDesktopPage(newPage) {
            desktopCurrentPage = newPage;
            const filtered = getFilteredCustomers();
            renderDesktopTable(filtered);
            const tableContainer = document.getElementById('customerTableContainer');
            if (tableContainer) {
                const rect = tableContainer.getBoundingClientRect();
                if (rect.top < 0) {
                    tableContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        }

        // 2. DESKTOP TABLE RENDER
        function renderDesktopTable(filtered) {
            const tbody = document.getElementById('desktopTableBody');
            const paginationContainer = document.getElementById('desktopPaginationContainer');
            const paginationInfo = document.getElementById('desktopPaginationInfo');
            const paginationControls = document.getElementById('desktopPaginationControls');
            const topSelect = document.getElementById('desktopPageSizeSelect');
            const bottomSelect = document.getElementById('desktopBottomPageSizeSelect');

            if (topSelect) topSelect.value = desktopPageSize;
            if (bottomSelect) bottomSelect.value = desktopPageSize;

            const totalCount = filtered.length;

            if (totalCount === 0) {
                if (customers.length === 0) {
                    tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-16 px-6 text-center">
                            <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-2xl shadow-inner">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <h3 class="text-base font-black text-slate-800">Tamam Data Saaf Ho Chuka Hai (List Khali Hai)</h3>
                            <p class="text-xs text-slate-500 mt-1 mb-5">Aapka portal bilkul clean ho gaya hai. Ab aap apna naya data fresh import kar sakte hain.</p>
                            <div class="flex items-center justify-center gap-3">
                                <button onclick="openModal('importModal')" class="px-5 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-xl text-xs shadow-md shadow-cyan-500/20 transition flex items-center gap-2">
                                    <i class="fa-solid fa-file-import"></i>
                                    <span>Naya Data Bulk Import Karein</span>
                                </button>
                                <button onclick="openModal('addModal')" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs shadow-md shadow-blue-500/20 transition flex items-center gap-2">
                                    <i class="fa-solid fa-user-plus"></i>
                                    <span>+ Naya User Shamil Karein</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    `;
                } else if (currentAppPage === 'dashboard' && customers.some(c => c.status === 'PAID')) {
                    const paidCount = customers.filter(c => c.status === 'PAID').length;
                    tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-12 px-6 text-center">
                            <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl shadow-inner">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                            <h3 class="text-base font-black text-slate-800">Shabash! Koi Baqi Bill Nahi Hai</h3>
                            <p class="text-xs text-slate-500 mt-1 mb-4">Dashboard sirf baqi recovery ke liye hai. Tamam <strong>${paidCount}</strong> users ke bills wasool ho chuke hain aur Paid Users Folder me mehfooz hain.</p>
                            <button onclick="openPage('paidCustomers')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl text-xs shadow-md shadow-emerald-500/20 transition inline-flex items-center gap-2">
                                <i class="fa-solid fa-folder-closed"></i>
                                <span>Paid Users Folder Kholein (${paidCount})</span>
                            </button>
                        </td>
                    </tr>`;
                } else {
                    tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-slate-400">Koi user nahi mila. Search ya filter tabdeel karein.</td></tr>`;
                }
                if (paginationContainer) paginationContainer.classList.add('hidden');
                return;
            }

            if (paginationContainer) paginationContainer.classList.remove('hidden');

            let pageSizeNum = desktopPageSize === 'ALL' ? totalCount : parseInt(desktopPageSize, 10);
            if (!pageSizeNum || isNaN(pageSizeNum) || pageSizeNum <= 0) pageSizeNum = 10;

            const totalPages = Math.max(1, Math.ceil(totalCount / pageSizeNum));
            if (desktopCurrentPage > totalPages) desktopCurrentPage = totalPages;
            if (desktopCurrentPage < 1) desktopCurrentPage = 1;

            const startIdx = (desktopCurrentPage - 1) * pageSizeNum;
            const endIdx = Math.min(startIdx + pageSizeNum, totalCount);
            const paginatedItems = filtered.slice(startIdx, endIdx);

            tbody.innerHTML = paginatedItems.map(c => {
                const isPaid = c.status === 'PAID';
                const isPartial = c.status === 'PARTIAL';
                const currentDue = (c.dueAmount !== undefined) ? Number(c.dueAmount) : (isPaid ? 0 : Number(c.fee));

                return `
                <tr class="hover:bg-slate-50/80 transition">
                    <td class="py-3.5 px-6">
                        <div class="font-extrabold text-slate-900 flex items-center gap-2">
                            <span class="cursor-pointer hover:text-blue-600 transition" onclick="openHistoryModal(${c.id})">${c.name}</span>
                            <button type="button" onclick="openHistoryModal(${c.id})" class="text-[9px] text-blue-700 bg-blue-50 hover:bg-blue-100 font-bold px-1.5 py-0.5 rounded border border-blue-200/80 inline-flex items-center gap-0.5 transition" title="Paid History Dekhein">
                                <i class="fa-solid fa-clock-rotate-left text-[8px]"></i> History
                            </button>
                        </div>
                        <div class="text-[11px] text-slate-400 font-mono flex items-center gap-2 flex-wrap">
                            <span>User: <strong class="text-slate-700">${c.userid || 'N/A'}</strong></span>
                            ${c.password ? `<span class="text-slate-400">| Pass: <code class="text-blue-600 bg-blue-50 px-1 py-0.5 rounded border border-blue-200/50">${c.password}</code></span>` : ''}
                        </div>
                    </td>
                    <td class="py-3.5 px-6">
                        <div class="font-mono text-slate-800">${c.phone}</div>
                    </td>
                    <td class="py-3.5 px-6">
                        <span class="inline-flex items-center gap-1.5 text-slate-600">
                            <i class="fa-solid fa-location-dot text-rose-500 text-[10px]"></i> ${c.area}
                        </span>
                    </td>
                    <td class="py-3.5 px-6">
                        <div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 font-semibold text-[11px]">
                                <i class="fa-solid fa-wifi text-[10px]"></i> ${c.package}
                            </span>
                            ${c.expireDate ? `<div class="text-[10px] text-amber-600 font-medium mt-1 flex items-center gap-1"><i class="fa-regular fa-calendar-xmark text-[9px]"></i> Exp: ${c.expireDate}</div>` : ''}
                        </div>
                    </td>
                    <td class="py-3.5 px-6">
                        <div class="font-extrabold text-slate-900 text-sm">Rs ${c.fee.toLocaleString()}</div>
                        ${isPartial ? `<div class="text-[10px] text-emerald-600 font-bold">Wasool: Rs ${Number(c.paidAmount || 0).toLocaleString()}</div><div class="text-[10px] text-rose-600 font-bold">Baqi: Rs ${currentDue.toLocaleString()}</div>` : ''}
                    </td>
                    <td class="py-3.5 px-6">
                        ${isPaid ? `
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold text-[11px]">
                                <i class="fa-solid fa-check text-[10px]"></i>
                                Paid (${c.paidAt || 'Done'})
                            </span>
                        ` : (isPartial ? `
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 font-bold text-[11px]">
                                <i class="fa-solid fa-hourglass-half text-[10px]"></i>
                                Partial (Baqi Rs ${currentDue.toLocaleString()})
                            </span>
                        ` : `
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200 font-bold text-[11px]">
                                <i class="fa-solid fa-hourglass-start text-[10px]"></i>
                                Pending Bill
                            </span>
                        `)}
                    </td>
                    <td class="py-3.5 px-6 text-right space-x-1">
                        ${isPaid ? `
                            <button onclick="revertToUnpaid(${c.id})" 
                                    class="px-3 py-1.5 rounded-lg font-bold text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition shadow-sm">
                                <i class="fa-solid fa-arrow-rotate-left text-[10px] mr-1"></i>Unpaid
                            </button>
                            <button type="button" onclick="sendWhatsAppMessage(${c.id}, true)" 
                               class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-lg font-bold text-xs inline-flex items-center gap-1 transition">
                                <i class="fa-brands fa-whatsapp text-sm"></i>
                                <span>Receipt</span>
                            </button>
                        ` : (isPartial ? `
                            <button onclick="openPaymentModalById(${c.id})" 
                                    class="px-3 py-1.5 rounded-lg font-bold text-xs bg-amber-600 hover:bg-amber-700 text-white shadow-amber-500/20 transition shadow-sm">
                                <i class="fa-solid fa-coins text-[10px] mr-1"></i>Baqi Wasool
                            </button>
                            <button onclick="revertToUnpaid(${c.id})" 
                                    class="px-3 py-1.5 rounded-lg font-bold text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition shadow-sm">
                                <i class="fa-solid fa-arrow-rotate-left text-[10px] mr-1"></i>Unpaid
                            </button>
                            <button type="button" onclick="sendWhatsAppMessage(${c.id}, false)" 
                               class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-lg font-bold text-xs inline-flex items-center gap-1 transition">
                                <i class="fa-brands fa-whatsapp text-sm"></i>
                                <span>Remind</span>
                            </button>
                        ` : `
                            <button onclick="openPaymentModalById(${c.id})" 
                                    class="px-3 py-1.5 rounded-lg font-bold text-xs bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/20 transition shadow-sm">
                                <i class="fa-solid fa-check-double text-[10px] mr-1"></i>Wasool Karein
                            </button>
                            <button type="button" onclick="sendWhatsAppMessage(${c.id}, false)" 
                               class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-lg font-bold text-xs inline-flex items-center gap-1 transition">
                                <i class="fa-brands fa-whatsapp text-sm"></i>
                                <span>Remind</span>
                            </button>
                        `)}
                        <button onclick="openHistoryModal(${c.id})" class="p-1.5 text-slate-400 hover:text-blue-600 transition" title="Paid History">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </button>
                        <button onclick="editCustomer(${c.id})" class="p-1.5 text-slate-400 hover:text-blue-600 transition" title="Edit">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button onclick="deleteCustomer(${c.id})" class="p-1.5 text-slate-400 hover:text-rose-600 transition" title="Delete">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                `;
            }).join('');

            // Update Pagination Info
            if (paginationInfo) {
                paginationInfo.innerHTML = `Showing <strong class="text-slate-900 font-extrabold">${startIdx + 1}</strong> se <strong class="text-slate-900 font-extrabold">${endIdx}</strong> (Kul <strong class="text-blue-700 font-black">${totalCount}</strong> users)`;
            }

            // Render Pagination Controls
            if (paginationControls) {
                if (totalPages <= 1) {
                    paginationControls.innerHTML = '';
                } else {
                    let btnsHtml = '';
                    const isFirst = desktopCurrentPage === 1;
                    const isLast = desktopCurrentPage === totalPages;

                    btnsHtml += `
                        <button type="button" onclick="changeDesktopPage(1)" ${isFirst ? 'disabled' : ''} class="px-2 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${isFirst ? 'text-slate-300 cursor-not-allowed bg-slate-50' : 'text-slate-700 bg-white hover:bg-slate-100'} transition shadow-2xs" title="Pehla Safha">
                            <i class="fa-solid fa-angles-left"></i>
                        </button>
                        <button type="button" onclick="changeDesktopPage(${desktopCurrentPage - 1})" ${isFirst ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${isFirst ? 'text-slate-300 cursor-not-allowed bg-slate-50' : 'text-slate-700 bg-white hover:bg-slate-100'} transition flex items-center gap-1 shadow-2xs" title="Pichla Safha">
                            <i class="fa-solid fa-chevron-left text-[10px]"></i>
                            <span class="hidden sm:inline">Pichla</span>
                        </button>
                    `;

                    let startP = Math.max(1, desktopCurrentPage - 2);
                    let endP = Math.min(totalPages, startP + 4);
                    if (endP - startP < 4) {
                        startP = Math.max(1, endP - 4);
                    }

                    if (startP > 1) {
                        btnsHtml += `<button type="button" onclick="changeDesktopPage(1)" class="w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 bg-white hover:bg-slate-100 transition shadow-2xs">1</button>`;
                        if (startP > 2) {
                            btnsHtml += `<span class="px-1 text-slate-400 font-bold">...</span>`;
                        }
                    }

                    for (let p = startP; p <= endP; p++) {
                        if (p === desktopCurrentPage) {
                            btnsHtml += `<button type="button" class="w-8 h-8 rounded-lg bg-blue-600 text-white font-black text-xs shadow-xs pointer-events-none">${p}</button>`;
                        } else {
                            btnsHtml += `<button type="button" onclick="changeDesktopPage(${p})" class="w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 bg-white hover:bg-slate-100 transition shadow-2xs">${p}</button>`;
                        }
                    }

                    if (endP < totalPages) {
                        if (endP < totalPages - 1) {
                            btnsHtml += `<span class="px-1 text-slate-400 font-bold">...</span>`;
                        }
                        btnsHtml += `<button type="button" onclick="changeDesktopPage(${totalPages})" class="w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold text-slate-700 bg-white hover:bg-slate-100 transition shadow-2xs">${totalPages}</button>`;
                    }

                    btnsHtml += `
                        <button type="button" onclick="changeDesktopPage(${desktopCurrentPage + 1})" ${isLast ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${isLast ? 'text-slate-300 cursor-not-allowed bg-slate-50' : 'text-slate-700 bg-white hover:bg-slate-100'} transition flex items-center gap-1 shadow-2xs" title="Agla Safha">
                            <span class="hidden sm:inline">Agla</span>
                            <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </button>
                        <button type="button" onclick="changeDesktopPage(${totalPages})" ${isLast ? 'disabled' : ''} class="px-2 py-1.5 rounded-lg border border-slate-200 text-xs font-bold ${isLast ? 'text-slate-300 cursor-not-allowed bg-slate-50' : 'text-slate-700 bg-white hover:bg-slate-100'} transition shadow-2xs" title="Aakhri Safha">
                            <i class="fa-solid fa-angles-right"></i>
                        </button>
                    `;

                    paginationControls.innerHTML = btnsHtml;
                }
            }
        }

        // ----------------------------------------------------
        // 💵 PAYMENT MODAL & PARTIAL BILL COLLECTION
        // ----------------------------------------------------
        let activePayCustomer = null;

        function openPaymentModal(customer) {
            activePayCustomer = customer;
            document.getElementById('payModalCustomerId').value = customer.id;

            // 1. Customer Summary (Exact Match with Image: CUSTID | NAME | MONTH/YEAR | TYPE | NET AMOUNT)
            const idEl = document.getElementById('payModalCustIdDisplay');
            if (idEl) idEl.textContent = customer.userid || customer.id;

            const nameEl = document.getElementById('payModalCustName');
            if (nameEl) nameEl.textContent = customer.name;

            const monthEl = document.getElementById('payModalMonthYear');
            if (monthEl) {
                const now = new Date();
                monthEl.textContent = now.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            }

            const typeEl = document.getElementById('payModalTypeDisplay');
            if (typeEl) typeEl.textContent = customer.package || 'Internet';

            const currentDue = (customer.dueAmount !== undefined) ? Number(customer.dueAmount) : (customer.status === 'PAID' ? 0 : Number(customer.fee));
            const defaultPay = currentDue > 0 ? currentDue : Number(customer.fee);

            const feeEl = document.getElementById('payModalCustFee');
            if (feeEl) feeEl.textContent = defaultPay.toLocaleString();

            // 2. Receipt ID (Auto-generated 12 digits like '186332210381')
            const receiptEl = document.getElementById('payReceiptId');
            if (receiptEl) {
                const randPart = Math.floor(100000000 + Math.random() * 900000000);
                receiptEl.value = '186' + String(randPart);
            }

            // 3. Receiving Date (Today)
            const dateEl = document.getElementById('payReceivingDate');
            if (dateEl) {
                dateEl.value = new Date().toISOString().split('T')[0];
            }

            // 4. Connection Type
            const connTypeEl = document.getElementById('payConnectionType');
            if (connTypeEl) {
                if (customer.package && /cable/i.test(customer.package)) {
                    connTypeEl.value = 'Cable TV';
                } else if (customer.package && /fiber/i.test(customer.package)) {
                    connTypeEl.value = 'Fiber Net';
                } else {
                    connTypeEl.value = 'Internet';
                }
            }

            // 5. Receive Amount Input (prefilled with due amount, editable)
            const input = document.getElementById('payAmountInput');
            if (input) input.value = defaultPay;

            // 6. Cash Type
            const cashTypeEl = document.getElementById('payCashType');
            if (cashTypeEl) cashTypeEl.value = 'Cash';

            // 7. Already Paid Info
            const alreadyPaid = Number(customer.paidAmount) || 0;
            const alreadyEl = document.getElementById('payModalAlreadyPaid');
            if (alreadyEl) {
                if (alreadyPaid > 0) {
                    alreadyEl.textContent = `Pehle Wasool Shuda: Rs ${alreadyPaid.toLocaleString()}`;
                    alreadyEl.classList.remove('hidden');
                } else {
                    alreadyEl.textContent = '';
                    alreadyEl.classList.add('hidden');
                }
            }

            // 8. Generate quick chips
            const chipsContainer = document.getElementById('payQuickChips');
            if (chipsContainer) {
                let chipsHtml = `
                    <button type="button" onclick="setPayAmount(${defaultPay})" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg font-bold text-[11px] transition">
                        Pura (${defaultPay.toLocaleString()})
                    </button>
                `;
                if (defaultPay > 500) {
                    const half = Math.round(defaultPay / 2 / 50) * 50;
                    chipsHtml += `
                        <button type="button" onclick="setPayAmount(${half})" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold text-[11px] transition">
                            Aadha (${half.toLocaleString()})
                        </button>
                    `;
                }
                if (defaultPay >= 1000) {
                    chipsHtml += `
                        <button type="button" onclick="setPayAmount(1000)" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold text-[11px] transition">
                            1,000
                        </button>
                    `;
                }
                if (defaultPay >= 1500) {
                    chipsHtml += `
                        <button type="button" onclick="setPayAmount(500)" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold text-[11px] transition">
                            500
                        </button>
                    `;
                }
                chipsContainer.innerHTML = chipsHtml;
            }

            // 9. Show Unpaid button in modal footer if partial or paid
            const unpaidBtn = document.getElementById('payModalUnpaidBtn');
            if (unpaidBtn) {
                if (customer.status === 'PARTIAL' || customer.status === 'PAID' || Number(customer.paidAmount) > 0) {
                    unpaidBtn.classList.remove('hidden');
                } else {
                    unpaidBtn.classList.add('hidden');
                }
            }

            onPayAmountInput();
            openModal('paymentModal');
            if (input) setTimeout(() => input.select(), 100);
        }

        function setPayAmount(val) {
            document.getElementById('payAmountInput').value = val;
            onPayAmountInput();
        }

        function onPayAmountInput() {
            if (!activePayCustomer) return;
            const entered = Number(document.getElementById('payAmountInput').value) || 0;
            const currentDue = (activePayCustomer.dueAmount !== undefined) ? Number(activePayCustomer.dueAmount) : Number(activePayCustomer.fee);
            const calcBox = document.getElementById('payCalculationBox');
            const choiceBox = document.getElementById('partialChoiceContainer');

            if (entered >= currentDue && currentDue > 0) {
                calcBox.className = 'p-3 rounded-xl text-xs space-y-1 bg-emerald-50 border border-emerald-200 text-emerald-800 transition';
                calcBox.innerHTML = `
                    <div class="flex items-center justify-between font-bold">
                        <span>Wasool Hogi:</span>
                        <span class="text-sm font-black text-emerald-700">Rs ${entered.toLocaleString()}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-emerald-600">
                        <span>Baqi Raqam:</span>
                        <span class="font-bold">Rs 0 (Pura Bill Clear)</span>
                    </div>
                `;
                choiceBox.classList.add('hidden');
            } else if (entered > 0 && entered < currentDue) {
                const diff = currentDue - entered;
                calcBox.className = 'p-3 rounded-xl text-xs space-y-1 bg-amber-50 border border-amber-200 text-amber-900 transition';
                calcBox.innerHTML = `
                    <div class="flex items-center justify-between font-bold">
                        <span>Wasool Hogi (Partial):</span>
                        <span class="text-sm font-black text-amber-700">Rs ${entered.toLocaleString()}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-rose-600 font-bold">
                        <span>Baqi (Remaining Due):</span>
                        <span>Rs ${diff.toLocaleString()}</span>
                    </div>
                `;
                choiceBox.classList.remove('hidden');
            } else {
                calcBox.className = 'p-3 rounded-xl text-xs space-y-1 bg-slate-50 border border-slate-200 text-slate-700 transition';
                calcBox.innerHTML = `
                    <div class="text-center font-bold text-slate-500">Raqam darj karein</div>
                `;
                choiceBox.classList.add('hidden');
            }
        }

        async function confirmPaymentCollection() {
            const custId = document.getElementById('payModalCustomerId').value;
            const custIndex = customers.findIndex(c => String(c.id) === String(custId));
            const targetCustomer = custIndex !== -1 ? customers[custIndex] : activePayCustomer;
            
            if (!targetCustomer) {
                toastr.error("User record nahi mila.");
                return;
            }

            const entered = Number(document.getElementById('payAmountInput').value);
            if (isNaN(entered) || entered <= 0) {
                toastr.error("Baraye meherbani koi durust raqam darj karein.");
                return;
            }

            const receiptId = document.getElementById('payReceiptId')?.value.trim() || String(Date.now());
            const receivingDate = document.getElementById('payReceivingDate')?.value || new Date().toISOString().split('T')[0];
            const connectionType = document.getElementById('payConnectionType')?.value || 'Internet';
            const cashType = document.getElementById('payCashType')?.value || 'Cash';

            const currentDue = (targetCustomer.dueAmount !== undefined) ? Number(targetCustomer.dueAmount) : Number(targetCustomer.fee);
            const now = new Date();
            const timeStr = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) + ', ' + 
                            now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const partialMode = document.querySelector('input[name="payPartialMode"]:checked')?.value || 'keep_due';

            targetCustomer.receiptId = receiptId;
            targetCustomer.receivingDate = receivingDate;
            targetCustomer.connectionType = connectionType;
            targetCustomer.cashType = cashType;

            if (entered >= currentDue || partialMode === 'discount_settle') {
                const finalPaid = entered >= currentDue ? (Number(targetCustomer.paidAmount || 0) + entered) : entered;
                targetCustomer.status = 'PAID';
                targetCustomer.paidAmount = finalPaid;
                targetCustomer.dueAmount = 0;
                targetCustomer.paidAt = timeStr;
                toastr.success(`Rs. ${entered.toLocaleString()} Wasool (${cashType})! Bill Mukammal PAID ho gaya.`);
            } else {
                const newPaid = (Number(targetCustomer.paidAmount) || 0) + entered;
                const newDue = Math.max(0, currentDue - entered);
                targetCustomer.status = 'PARTIAL';
                targetCustomer.paidAmount = newPaid;
                targetCustomer.dueAmount = newDue;
                targetCustomer.paidAt = timeStr;
                toastr.info(`Rs. ${entered.toLocaleString()} Partial Wasool (${cashType})! Baqi: Rs. ${newDue.toLocaleString()}`);
            }

            // Record in Customer Paid History
            if (!targetCustomer.history) targetCustomer.history = [];
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const rDate = new Date(receivingDate || Date.now());
            const monthYearStr = `${monthNames[rDate.getMonth()]} ${rDate.getFullYear()}`;
            const dayStr = String(now.getDate()).padStart(2, '0');
            const monNow = monthNames[now.getMonth()];
            const yrNow = now.getFullYear();
            const hoursStr = String(now.getHours()).padStart(2, '0');
            const minsStr = String(now.getMinutes()).padStart(2, '0');
            const secsStr = String(now.getSeconds()).padStart(2, '0');
            const exactDateTimeStr = `${dayStr}/${monNow}/${yrNow} ${hoursStr}:${minsStr}:${secsStr}`;

            const newHistoryItem = {
                billId: receiptId,
                monthYear: monthYearStr,
                collectionType: connectionType,
                paymentType: 'Monthly',
                receivedAmount: entered,
                receivedDate: exactDateTimeStr,
                status: targetCustomer.status === 'PAID' ? 'paid' : 'partial',
                remarks: '',
                receivedBy: `${ispName || 'sonybox'} by ${cashType} (0)`,
                cashType: cashType,
                paidAmount: entered,
                dueAmount: targetCustomer.dueAmount || 0,
                timestamp: Date.now()
            };
            targetCustomer.history.unshift(newHistoryItem);

            if (custIndex !== -1) {
                customers[custIndex] = targetCustomer;
            }

            saveToStorage();
            renderAllViews();
            closeModal('paymentModal');

            // Instantly sync to server
            try {
                await pushDataToCloud(true);
            } catch (err) {}

            // Open WhatsApp receipt only if checked
            const sendReceipt = document.getElementById('paySendWhatsAppReceipt')?.checked;
            if (sendReceipt) {
                let formattedPhone = String(targetCustomer.phone || '').replace(/[^0-9]/g, '');
                let waNumber = formattedPhone;
                if (waNumber.startsWith('0')) waNumber = '92' + waNumber.substring(1);
                const waReceiptMsg = buildWhatsAppReceipt(targetCustomer, entered);
                if (waNumber.length >= 10) {
                    setTimeout(() => {
                        window.open(`https://wa.me/${waNumber}?text=${waReceiptMsg}`, '_blank');
                    }, 200);
                }
            }

            activePayCustomer = null;
        }

        // Open payment modal by customer id helper
        function openPaymentModalById(id) {
            const customer = customers.find(c => String(c.id) === String(id));
            if (customer) openPaymentModal(customer);
        }

        // Triggered from Unpaid button inside the Receiving modal
        function onModalUnpaidClick() {
            if (!activePayCustomer) return;
            const cid = activePayCustomer.id;
            closeModal('paymentModal');
            revertToUnpaid(cid);
        }

        // Revert any customer (Paid or Partial) to completely Unpaid / Pending
        function revertToUnpaid(id) {
            const customer = customers.find(c => String(c.id) === String(id));
            if (!customer) return;

            const wasoolInfo = (Number(customer.paidAmount) > 0) ? ` (Pehle Wasool: Rs ${Number(customer.paidAmount).toLocaleString()})` : '';

            showConfirm({
                title: 'Bill Unpaid Karein?',
                message: `Kya aap ${customer.name} ka status dobara Unpaid (Pending) karna chahte hain?${wasoolInfo} Wasool shuda record reset ho kar kul fee Rs ${Number(customer.fee).toLocaleString()} dobara baqi ho jayegi.`,
                icon: 'fa-rotate-left',
                iconBg: 'bg-amber-100 text-amber-600',
                btnText: 'Haan, Unpaid Karein',
                btnClass: 'bg-amber-600 hover:bg-amber-700 text-white shadow-amber-500/25',
                onConfirm: async () => {
                    customer.status = 'PENDING';
                    customer.paidAt = null;
                    customer.paidAmount = 0;
                    customer.dueAmount = Number(customer.fee) || 0;
                    delete customer.receiptId;
                    delete customer.receivingDate;
                    delete customer.connectionType;
                    delete customer.cashType;
                    toastr.info(`${customer.name} ka status Unpaid kar diya gaya.`);
                    saveToStorage();
                    renderAllViews();
                    try {
                        await pushDataToCloud(true);
                    } catch (e) {
                        console.error("Cloud push failed:", e);
                    }
                }
            });
        }

        // Toggle Payment status with Confirmation Popup
        function togglePayment(id) {
            const customer = customers.find(c => String(c.id) === String(id));
            if (!customer) return;

            if (customer.status === 'PENDING') {
                openPaymentModal(customer);
            } else {
                revertToUnpaid(id);
            }
        }

        // Delete Customer with Confirmation Popup
        function deleteCustomer(id) {
            const c = customers.find(item => String(item.id) === String(id));
            if (!c) return;
            showConfirm({
                title: 'User Delete Karein?',
                message: `Kya aap waqai '${c.name}' ko mukammal delete karna chahte hain? Yeh record wapis nahi aayega.`,
                icon: 'fa-trash',
                iconBg: 'bg-rose-100 text-rose-600',
                btnText: 'Haan, Delete Karein',
                btnClass: 'bg-rose-600 hover:bg-rose-700 text-white shadow-rose-500/25',
                onConfirm: async () => {
                    customers = customers.filter(item => String(item.id) !== String(id));
                    saveToStorage();
                    renderAllViews();
                    try {
                        await pushDataToCloud(true);
                    } catch (e) {}
                    toastr.success("User delete ho gaya.");
                }
            });
        }

        // ============================================================
        // 📜 PAID HISTORY & 3-DOTS ACTION SUITE
        // ============================================================
        let activeHistoryCustomer = null;
        let activeHistoryItem = null;

        function openHistoryModalFromPayModal() {
            const custId = document.getElementById('payModalCustomerId')?.value || activePayCustomer?.id;
            if (custId) {
                closeModal('paymentModal');
                openHistoryModal(custId);
            }
        }

        function ensureCustomerHistory(c) {
            if (!c) return;
            if (!c.history || !Array.isArray(c.history) || c.history.length === 0) {
                if (c.name && c.name.toLowerCase() === 'asif') {
                    // Seed initial realistic historical records matching user reference screenshot
                    c.history = [
                        { billId: '186332210380', monthYear: 'Oct 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '05/Nov/2026 02:14:34', status: 'paid', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '186332205796', monthYear: 'Sep 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '08/Oct/2026 07:13:08', status: 'paid', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '186332197512', monthYear: 'Aug 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '15/Aug/2026 05:27:20', status: 'paid', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '186332197512', monthYear: 'Jul 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '15/Aug/2026 05:27:20', status: 'paid', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '186332187870', monthYear: 'Jun 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '15/Jun/2026 06:16:59', status: 'paid', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '186332183672', monthYear: 'May 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '18/May/2026 02:24:41', status: 'paid', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '24876749', monthYear: 'Apr 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '19/Apr/2026 12:41:50', status: 'paid', remarks: '', receivedBy: 'ahsan by Cash (0)', cashType: 'Cash' },
                        { billId: '22089100', monthYear: 'Mar 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '16/Mar/2026 11:55:04', status: 'partial', remarks: '', receivedBy: 'ahsan by Cash (0)', cashType: 'Cash' },
                        { billId: '186343863', monthYear: 'Feb 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1000, receivedDate: '17/Feb/2026 09:50:58', status: 'partial', remarks: '', receivedBy: 'sonybox by Cash (0)', cashType: 'Cash' },
                        { billId: '19717833', monthYear: 'Jan 2026', collectionType: 'Internet', paymentType: 'Monthly', receivedAmount: 1200, receivedDate: '28/Jan/2026 12:32:35', status: 'paid', remarks: '', receivedBy: 'ahsan by Cash (0)', cashType: 'Cash' }
                    ];
                } else if (c.paidAmount > 0 || c.status === 'PAID') {
                    c.history = [
                        {
                            billId: c.receiptId || String(Date.now()),
                            monthYear: new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' }),
                            collectionType: c.connectionType || c.package || 'Internet',
                            paymentType: 'Monthly',
                            receivedAmount: Number(c.paidAmount) || Number(c.fee),
                            receivedDate: c.paidAt || new Date().toISOString().replace('T', ' ').substring(0, 19),
                            status: c.status === 'PAID' ? 'paid' : 'partial',
                            remarks: '',
                            receivedBy: `${ispName || 'sonybox'} by ${c.cashType || 'Cash'} (0)`,
                            cashType: c.cashType || 'Cash'
                        }
                    ];
                } else {
                    c.history = [];
                }
            }
        }

        function openHistoryModal(customerId) {
            closeHistoryOptionsMenu();
            const customer = customers.find(c => String(c.id) === String(customerId));
            if (!customer) {
                toastr.error("Customer nahi mila.");
                return;
            }
            ensureCustomerHistory(customer);
            activeHistoryCustomer = customer;

            const subtitle = document.getElementById('historyModalSubtitle');
            if (subtitle) {
                subtitle.innerHTML = `<strong>${customer.name}</strong> (${customer.userid || 'N/A'}) • Phone: <strong>${customer.phone || '-'}</strong> • Area: <strong>${customer.area || '-'}</strong> • Package: <strong>${customer.package || '-'}</strong>`;
            }

            renderHistoryTable(customer.id);
            openModal('historyModal');
        }

        function renderHistoryTable(customerId) {
            const customer = customers.find(c => String(c.id) === String(customerId));
            if (!customer) return;

            const tbody = document.getElementById('historyTableBody');
            const emptyEl = document.getElementById('historyEmptyState');
            const countEl = document.getElementById('historyRecordCount');

            const list = customer.history || [];
            if (countEl) countEl.textContent = `Total Records: ${list.length}`;

            if (list.length === 0) {
                if (tbody) tbody.innerHTML = '';
                if (emptyEl) emptyEl.classList.remove('hidden');
                return;
            }

            if (emptyEl) emptyEl.classList.add('hidden');

            if (tbody) {
                tbody.innerHTML = list.map(item => {
                    let statusBadge = '';
                    if (item.status === 'paid') {
                        statusBadge = `<span class="inline-block px-3 py-0.5 rounded-full border border-emerald-400 text-emerald-600 bg-white text-[11px] font-semibold min-w-[55px] text-center">paid</span>`;
                    } else if (item.status === 'partial') {
                        statusBadge = `<span class="inline-block px-3 py-0.5 rounded-full border border-amber-400 text-amber-600 bg-white text-[11px] font-semibold min-w-[55px] text-center">partial</span>`;
                    } else {
                        statusBadge = `<span class="inline-block px-3 py-0.5 rounded-full border border-rose-400 text-rose-600 bg-white text-[11px] font-semibold min-w-[55px] text-center">unpaid</span>`;
                    }

                    return `
                        <tr class="hover:bg-slate-50/80 transition">
                            <td class="py-3 px-3 font-mono font-bold text-slate-900 whitespace-nowrap">${item.billId}</td>
                            <td class="py-3 px-3 text-slate-700 whitespace-nowrap">${item.monthYear}</td>
                            <td class="py-3 px-3 text-slate-700 whitespace-nowrap">${item.collectionType || 'Internet'}</td>
                            <td class="py-3 px-3 text-slate-700 whitespace-nowrap">${item.paymentType || 'Monthly'}</td>
                            <td class="py-3 px-3 font-extrabold text-slate-900 whitespace-nowrap">Rs ${Number(item.receivedAmount).toLocaleString()}</td>
                            <td class="py-3 px-3 text-slate-600 whitespace-nowrap font-mono text-[11px]">${item.receivedDate}</td>
                            <td class="py-3 px-3 text-center whitespace-nowrap">${statusBadge}</td>
                            <td class="py-3 px-3 text-slate-500 whitespace-nowrap">${item.remarks || '-'}</td>
                            <td class="py-3 px-3 text-slate-700 whitespace-nowrap">${item.receivedBy || (ispName + ' by Cash (0)')}</td>
                            <td class="py-3 px-3 text-center whitespace-nowrap">
                                <button type="button" 
                                        onclick="toggleHistoryMenu(event, this, '${item.billId}', '${customer.id}')" 
                                        class="w-8 h-8 rounded-lg text-slate-700 hover:text-blue-600 hover:bg-blue-50 border border-slate-200 hover:border-blue-300 transition inline-flex items-center justify-center text-base shadow-2xs cursor-pointer" 
                                        title="Options">
                                    <i class="fa-solid fa-ellipsis-vertical pointer-events-none"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }
        }

        function toggleHistoryMenu(event, btnEl, billId, customerId) {
            if (event) {
                event.stopPropagation();
                if (event.preventDefault) event.preventDefault();
            }
            const button = btnEl || event?.currentTarget || event?.target?.closest('button');
            if (!button) return;

            const customer = customers.find(c => String(c.id) === String(customerId));
            if (!customer) return;
            const item = (customer.history || []).find(h => String(h.billId) === String(billId));
            if (!item) return;

            activeHistoryCustomer = customer;
            activeHistoryItem = item;

            const menu = document.getElementById('historyOptionsMenu');
            if (!menu) return;

            if (!menu.classList.contains('hidden') && menu.dataset.activeBillId === String(billId)) {
                closeHistoryOptionsMenu();
                return;
            }

            menu.dataset.activeBillId = String(billId);
            const billIdDisplay = document.getElementById('historyMenuBillId');
            if (billIdDisplay) billIdDisplay.textContent = `#${billId}`;
            menu.classList.remove('hidden');

            const rect = button.getBoundingClientRect();
            const menuWidth = 208;
            const menuHeight = 195;

            // Viewport clamped positioning
            let left = rect.right - menuWidth;
            if (left + menuWidth > window.innerWidth - 12) {
                left = window.innerWidth - menuWidth - 12;
            }
            if (left < 12) left = 12;

            let top = rect.bottom + 6;
            if (top + menuHeight > window.innerHeight - 12) {
                top = rect.top - menuHeight - 6;
            }
            if (top < 12) top = 12;

            menu.style.position = 'fixed';
            menu.style.top = `${top}px`;
            menu.style.left = `${left}px`;
            menu.style.zIndex = '999999';
        }

        function closeHistoryOptionsMenu() {
            const menu = document.getElementById('historyOptionsMenu');
            if (menu) {
                menu.classList.add('hidden');
                menu.dataset.activeBillId = '';
            }
        }

        document.addEventListener('click', (e) => {
            const menu = document.getElementById('historyOptionsMenu');
            if (menu && !menu.classList.contains('hidden')) {
                if (!menu.contains(e.target) && !e.target.closest("button[title*='Options']")) {
                    closeHistoryOptionsMenu();
                }
            }
        });

        function triggerHistoryAction(action) {
            if (!activeHistoryCustomer || !activeHistoryItem) return;
            const billId = activeHistoryItem.billId;
            const customerId = activeHistoryCustomer.id;
            closeHistoryOptionsMenu();

            if (action === 'unpaid') {
                historyActionUnpaid(billId, customerId);
            } else if (action === 'duplicate') {
                historyActionDuplicateBill(billId, customerId);
            } else if (action === 'print') {
                historyActionPrint(billId, customerId);
            } else if (action === 'details') {
                historyActionViewDetails(billId, customerId);
            }
        }

        function historyActionUnpaid(billId, customerId) {
            const customer = customers.find(c => String(c.id) === String(customerId));
            if (!customer) return;
            const item = (customer.history || []).find(h => String(h.billId) === String(billId));
            if (!item) return;

            if (item.status === 'unpaid') {
                toastr.info("Yeh record pehle se Unpaid mark hai.");
                return;
            }

            showConfirm({
                title: 'Purana Bill Unpaid Karein?',
                message: `Kya aap Bill ID #${item.billId} (${item.monthYear} - Rs ${Number(item.receivedAmount).toLocaleString()}) ki payment ko Unpaid karna chahte hain? Yeh record Unpaid ho jayega.`,
                icon: 'fa-rotate-left',
                iconBg: 'bg-rose-100 text-rose-600',
                btnText: 'Haan, Unpaid Karein',
                btnClass: 'bg-rose-600 hover:bg-rose-700 text-white shadow-rose-500/25',
                onConfirm: async () => {
                    item.status = 'unpaid';
                    
                    // If this was the current active bill
                    if (String(customer.receiptId) === String(billId) || (customer.history && customer.history[0] === item)) {
                        customer.status = 'PENDING';
                        customer.paidAt = null;
                        customer.paidAmount = 0;
                        customer.dueAmount = Number(customer.fee) || 0;
                    }

                    toastr.success(`Bill #${item.billId} Unpaid mark kar diya gaya.`);
                    saveToStorage();
                    renderAllViews();
                    renderHistoryTable(customer.id);
                    try {
                        await pushDataToCloud(true);
                    } catch (e) {
                        console.error("Cloud push failed:", e);
                    }
                }
            });
        }

        function historyActionDuplicateBill(billId, customerId) {
            const customer = customers.find(c => String(c.id) === String(customerId));
            if (!customer) return;
            const item = (customer.history || []).find(h => String(h.billId) === String(billId));
