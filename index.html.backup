                                </button>
                                <button onclick="openPage('allCustomers')" id="tableTabAll" class="px-3 py-1.5 rounded-lg transition flex items-center gap-1.5 text-slate-600">
                                    <i class="fa-solid fa-users text-xs"></i>
                                    <span>All Users</span>
