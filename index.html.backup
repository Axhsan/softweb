                        class="w-full text-left p-3.5 rounded-2xl border border-slate-200 hover:border-rose-500 hover:bg-rose-50/30 transition flex items-center justify-between group">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-rose-500 text-white flex items-center justify-center text-lg shadow-sm">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
