                        </div>
                    </div>
                    <button type="button" onclick="fixCorruptedCustomerData(true)" class="px-5 py-2.5 bg-white text-orange-700 hover:bg-orange-50 active:scale-95 font-extrabold rounded-xl text-xs shadow-md transition shrink-0 flex items-center gap-2">
                        <i class="fa-solid fa-wrench"></i>
                        <span>1-Click Auto Fix Karein</span>
