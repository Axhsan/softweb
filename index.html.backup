            const area = document.getElementById('printableBillArea');
            if (!area) return;

            area.innerHTML = `
                <div class="border-2 border-dashed border-slate-300 rounded-2xl p-5 relative overflow-hidden bg-slate-50/50">
                    <!-- Watermark -->
                    <div class="absolute inset-0 flex items-center justify-center opacity-5 pointer-events-none select-none">
                        <span class="text-6xl font-black rotate-[-25deg] tracking-widest text-slate-900">DUPLICATE</span>
                    </div>

                    <!-- Header -->
                    <div class="text-center pb-4 border-b border-slate-200">
