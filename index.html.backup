                        </div>
                    </div>

                    <!-- Card 4: Quick Action -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between text-slate-500 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>Quick Reports</span>
                            <div class="w-8 h-8 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center">
                                <i class="fa-solid fa-print text-sm"></i>
                            </div>
                        </div>
                        <div class="text-lg font-bold text-slate-800">Print & Sheets</div>
                        <div class="mt-2 flex gap-2">
                            <button onclick="printFieldSheet()" class="text-xs font-bold text-purple-600 hover:underline">Field Sheet</button>
                            <span class="text-slate-300">|</span>
                            <button onclick="exportToCSV()" class="text-xs font-bold text-emerald-600 hover:underline">Excel Report</button>
                        </div>
                    </div>

                </div>

                <!-- Analytics Row: Chart + Status Filter Tabs -->
                <div class="grid grid-cols-3 gap-6">
                    <div class="col-span-2 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">Monthly ISP Recovery Performance</h3>
                                <p class="text-xs text-slate-500">Recovered cash vs Target Dues across past billing cycles</p>
                            </div>
                            <span class="text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-lg">Cycle: November 2026</span>
                        </div>
                        <div class="h-44">
                            <canvas id="deskChart"></canvas>
                        </div>
                    </div>

                    <div class="col-span-1 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-slate-900 mb-1">Status Quick Filter</h3>
                            <p class="text-xs text-slate-500 mb-4">Click to view specific list of customers</p>
                            <div class="space-y-2 text-xs">
                                <button onclick="filterStatus('PENDING')" class="w-full flex items-center justify-between p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 font-bold hover:bg-rose-100 transition">
                                    <span class="flex items-center gap-2"><i class="fa-solid fa-user-xmark text-rose-500"></i> Default Users (Baqi Fees)</span>
                                    <span id="deskFilterPending" class="bg-rose-200 text-rose-900 px-2 py-0.5 rounded-full text-[11px]">0</span>
                                </button>
                                <button onclick="filterStatus('PAID')" class="w-full flex items-center justify-between p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-bold hover:bg-emerald-100 transition">
                                    <span class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Wasool Shuda (Paid)</span>
                                    <span id="deskFilterPaid" class="bg-emerald-200 text-emerald-900 px-2 py-0.5 rounded-full text-[11px]">0</span>
                                </button>
                                <button onclick="filterStatus('ALL')" class="w-full flex items-center justify-between p-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-800 font-bold hover:bg-slate-200 transition">
                                    <span class="flex items-center gap-2"><i class="fa-solid fa-users text-slate-500"></i> Tamam Users (All)</span>
                                    <span id="deskFilterAll" class="bg-slate-300 text-slate-900 px-2 py-0.5 rounded-full text-[11px]">0</span>
                                </button>
                            </div>
                        </div>
                        <div class="pt-4 border-t border-slate-100 text-[11px] text-slate-400 text-center">
                            Powered by SonyBox ISP Engine
                        </div>
                    </div>
                </div>
                </div> <!-- End #desktopOverviewSection -->

                <!-- Dedicated Page Header on Desktop (Shown for All Customers / Default Users / Paid Pages) -->
                <div id="desktopDedicatedPageHeader" class="hidden bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4 transition">
                    <div class="flex items-center gap-3.5">
                        <button onclick="openPage('dashboard')" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition shadow-sm" title="Dashboard Wapis Jayein">
                            <i class="fa-solid fa-arrow-left text-sm"></i>
                        </button>
                        <div>
                            <div class="flex items-center gap-2.5">
                                <h1 id="pageHeaderTitle" class="text-xl font-black text-slate-900">All Customers Page</h1>
                                <span id="pageHeaderBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800">0 Users</span>
                            </div>
