                            <span class="font-extrabold text-slate-900">${customer.name}</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">User ID / Username:</span>
                            <span class="font-mono font-bold text-slate-800">${customer.userid || '-'}</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Mobile Phone:</span>
                            <span class="font-mono text-slate-800">${customer.phone || '-'}</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100">
                            <span class="text-slate-500">Area / Colony:</span>
