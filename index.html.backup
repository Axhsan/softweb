            openModal('duplicateBillModal');
        }

        function printHistoryBillCurrent() {
            if (!activeHistoryItem || !activeHistoryCustomer) return;
            historyActionPrint(activeHistoryItem.billId, activeHistoryCustomer.id);
        }

        function historyActionPrint(billId, customerId) {
