                                <i class="fa-solid fa-trash-can"></i>
                                <span>Delete All</span>
                            </button>

                            <button type="button" onclick="exportToCSV()" class="px-3 py-1.5 border border-slate-300 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-700 flex items-center gap-1.5 transition shadow-sm">
                                <i class="fa-solid fa-file-excel text-emerald-600"></i>
