                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="pt-3 border-t border-slate-200 text-center text-[10px] text-slate-500 space-y-1">
                        <div>Received By: <strong>${item.receivedBy || (ispName + ' by Cash')}</strong></div>
                        ${ispHelpline ? `<div>Helpline / Shikayat: <strong>${ispHelpline}</strong></div>` : ''}
