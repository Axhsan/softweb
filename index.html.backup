            if (!customer) return;
            const item = (customer.history || []).find(h => String(h.billId) === String(billId));
            if (!item) return;

            const printHtml = `
                <div style="font-family: Arial, sans-serif; max-width: 320px; margin: 0 auto; padding: 12px; border: 1px dashed #333; line-height: 1.4;">
                    <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 8px; margin-bottom: 10px;">
                        <h2 style="margin: 0; font-size: 18px; font-weight: 900;">${ispName || 'SonyBox ISP'}</h2>
                        <p style="margin: 2px 0 0; font-size: 11px; letter-spacing: 1px;">INTERNET PAYMENT RECEIPT</p>
                        <p style="margin: 4px 0 0; font-size: 10px; font-weight: bold; background: #000; color: #fff; display: inline-block; padding: 1px 8px; border-radius: 3px;">
                            ${item.status === 'paid' ? 'PAID' : (item.status === 'partial' ? 'PARTIAL' : 'UNPAID')}
                        </p>
                    </div>
                    <table style="width: 100%; font-size: 11px; margin-bottom: 10px;">
                        <tr><td style="color: #555;">Bill ID:</td><td style="text-align: right; font-weight: bold; font-family: monospace;">${item.billId}</td></tr>
                        <tr><td style="color: #555;">Date:</td><td style="text-align: right;">${item.receivedDate}</td></tr>
                        <tr><td style="color: #555;">Customer:</td><td style="text-align: right; font-weight: bold;">${customer.name}</td></tr>
                        <tr><td style="color: #555;">User ID:</td><td style="text-align: right; font-family: monospace;">${customer.userid || '-'}</td></tr>
                        <tr><td style="color: #555;">Phone:</td><td style="text-align: right;">${customer.phone || '-'}</td></tr>
                        <tr><td style="color: #555;">Area:</td><td style="text-align: right;">${customer.area || '-'}</td></tr>
                        <tr><td style="color: #555;">Month:</td><td style="text-align: right; font-weight: bold;">${item.monthYear}</td></tr>
                        <tr><td style="color: #555;">Type:</td><td style="text-align: right;">${item.collectionType || 'Internet'}</td></tr>
                        <tr><td style="color: #555;">Payment Mode:</td><td style="text-align: right;">${item.cashType || 'Cash'}</td></tr>
                        <tr style="border-top: 1px solid #ccc; font-weight: bold; font-size: 13px;">
                            <td style="padding-top: 5px;">Wasool Raqam:</td>
                            <td style="text-align: right; padding-top: 5px;">Rs. ${Number(item.receivedAmount).toLocaleString()}</td>
                        </tr>
                    </table>
                    <div style="border-top: 2px dashed #000; padding-top: 6px; text-align: center; font-size: 10px; color: #444;">
                        <p style="margin: 0;">Received By: ${item.receivedBy || (ispName + ' by Cash')}</p>
                        ${ispHelpline ? `<p style="margin: 2px 0 0;">Helpline: ${ispHelpline}</p>` : ''}
                        <p style="margin: 4px 0 0; font-weight: bold;">Shukriya! (SonyBox ISP)</p>
                    </div>
                </div>
            `;

            const iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            document.body.appendChild(iframe);
            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write('<html><head><title>Receipt_' + item.billId + '</title></head><body>' + printHtml + '</body></html>');
            doc.close();
            iframe.contentWindow.focus();
            setTimeout(() => {
                iframe.contentWindow.print();
                setTimeout(() => iframe.remove(), 2500);
            }, 300);
