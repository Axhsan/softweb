                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Payment Mode / Cash Type:</span>
                        <span class="font-semibold text-slate-800">${item.cashType || 'Cash'}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Received Date & Time:</span>
                        <span class="font-mono text-slate-800">${item.receivedDate}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Received By:</span>
                        <span class="font-semibold text-slate-800">${item.receivedBy || (ispName + ' by Cash (0)')}</span>
                    </div>
                    <div class="flex justify-between pt-2 border-t border-slate-200 font-extrabold text-sm">
                        <span class="text-slate-900">Wasool Raqam:</span>
                        <span class="text-emerald-600 font-black">Rs. ${Number(item.receivedAmount).toLocaleString()}</span>
                    </div>
                    ${item.remarks ? `
                        <div class="pt-2 border-t border-slate-200 text-slate-600">
                            <span class="font-bold text-slate-500 block text-[10px]">Remarks:</span>
                            <span class="italic text-xs">${item.remarks}</span>
                        </div>
                    ` : ''}
                </div>
            `;

            openModal('historyDetailsModal');
        }

        function openAddHistoryRecordModal() {
            if (!activeHistoryCustomer) return;
            const now = new Date();
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const prevMonth = (now.getMonth() === 0) ? 11 : now.getMonth() - 1;
            const prevYear = (now.getMonth() === 0) ? now.getFullYear() - 1 : now.getFullYear();
            
            const monthInput = document.getElementById('histInputMonthYear');
            if (monthInput) monthInput.value = `${monthNames[prevMonth]} ${prevYear}`;
            
            const amtInput = document.getElementById('histInputAmount');
            if (amtInput) amtInput.value = activeHistoryCustomer.fee || 1000;

            const dateInput = document.getElementById('histInputDate');
            if (dateInput) {
                const nowIso = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16);
                dateInput.value = nowIso;
            }

            openModal('addHistoryModal');
        }

        function saveCustomHistoryRecord(e) {
            e.preventDefault();
            if (!activeHistoryCustomer) return;

            const mYear = document.getElementById('histInputMonthYear').value.trim();
            const amt = Number(document.getElementById('histInputAmount').value);
            const status = document.getElementById('histInputStatus').value;
            const connType = document.getElementById('histInputConnType').value;
            const cashType = document.getElementById('histInputCashType').value;
            const dateVal = document.getElementById('histInputDate').value;
            const remarks = document.getElementById('histInputRemarks').value.trim();

            const d = dateVal ? new Date(dateVal) : new Date();
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const dayStr = String(d.getDate()).padStart(2, '0');
            const monStr = monthNames[d.getMonth()];
            const yrStr = d.getFullYear();
            const hoursStr = String(d.getHours()).padStart(2, '0');
            const minsStr = String(d.getMinutes()).padStart(2, '0');
            const secsStr = String(d.getSeconds()).padStart(2, '0');
            const exactDateStr = `${dayStr}/${monStr}/${yrStr} ${hoursStr}:${minsStr}:${secsStr}`;

            const randId = '186' + String(Math.floor(100000000 + Math.random() * 900000000));

            const entry = {
                billId: randId,
                monthYear: mYear,
                collectionType: connType,
                paymentType: 'Monthly',
                receivedAmount: amt,
                receivedDate: exactDateStr,
                status: status,
                remarks: remarks,
                receivedBy: `${ispName || 'sonybox'} by ${cashType} (0)`,
                cashType: cashType,
                paidAmount: amt,
                timestamp: d.getTime()
            };

            if (!activeHistoryCustomer.history) activeHistoryCustomer.history = [];
            activeHistoryCustomer.history.unshift(entry);

            saveToStorage();
            closeModal('addHistoryModal');
            renderHistoryTable(activeHistoryCustomer.id);
            toastr.success(`Purani entry #${randId} shamil kar di gayi.`);
            pushDataToCloud(true).catch(() => {});
        }

        function sendDuplicateBillWhatsApp() {
            if (!activeHistoryCustomer || !activeHistoryItem) return;
            const c = activeHistoryCustomer;
            const item = activeHistoryItem;
            const cleanPhone = (c.phone || '').replace(/[^0-9]/g, '');
            let waNumber = cleanPhone;
            if (waNumber.startsWith('03')) waNumber = '92' + waNumber.substring(1);

            const msg = `🧾 *DUPLICATE BILL RECEIPT* - ${ispName || 'SonyBox ISP'}\n` +
                        `━━━━━━━━━━━━━━━━━━━━\n` +
                        `👤 *Customer:* ${c.name}\n` +
                        `🆔 *User ID:* ${c.userid || '-'}\n` +
                        `🔢 *Bill ID:* ${item.billId}\n` +
                        `📅 *Month:* ${item.monthYear}\n` +
                        `📡 *Connection:* ${item.collectionType || 'Internet'}\n` +
                        `💵 *Wasool Raqam:* Rs ${Number(item.receivedAmount).toLocaleString()}\n` +
                        `💳 *Payment Mode:* ${item.cashType || 'Cash'}\n` +
                        `🕒 *Date/Time:* ${item.receivedDate}\n` +
                        `📌 *Status:* ${item.status.toUpperCase()}\n` +
                        `━━━━━━━━━━━━━━━━━━━━\n` +
                        `Shukriya! (Computer Generated Duplicate Slip)`;
            window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        // Populate unique areas into dropdowns (both PC & mobile)
        function populateAreas() {
            const selectMobile = document.getElementById('areaFilter');
            const selectDesk = document.getElementById('deskAreaFilter');
            const areas = Array.from(new Set(customers.map(c => c.area).filter(Boolean))).sort();
            
            const optionsHtml = '<option value="ALL">Tamam Ilaqay / Galiyan</option>' + 
                areas.map(a => `<option value="${a}" ${a === currentAreaFilter ? 'selected' : ''}>${a}</option>`).join('');

            selectMobile.innerHTML = optionsHtml;
            selectDesk.innerHTML = optionsHtml;
        }

        // Update statistics on both Mobile and Desktop
        function updateStats() {
            let totalPaid = 0;
            let totalPending = 0;
            let paidCount = 0;
            let pendingCount = 0;

            customers.forEach(c => {
                const fee = Number(c.fee) || 0;
                if (c.status === 'PAID') {
                    const paid = (c.paidAmount !== undefined && c.paidAmount !== null && Number(c.paidAmount) > 0) ? Number(c.paidAmount) : fee;
                    totalPaid += paid;
                    paidCount++;
                } else if (c.status === 'PARTIAL') {
                    const paid = Number(c.paidAmount) || 0;
                    const due = (c.dueAmount !== undefined && c.dueAmount !== null) ? Number(c.dueAmount) : Math.max(0, fee - paid);
                    totalPaid += paid;
                    totalPending += due;
                    pendingCount++;
                } else {
                    totalPending += fee;
                    pendingCount++;
                }
            });

            const totalCount = customers.length;
            const totalDemand = totalPaid + totalPending;
            const recoveryRate = totalDemand > 0 ? Math.round((totalPaid / totalDemand) * 100) : 0;

            const setTxt = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };

            // Mobile stats
            setTxt('statPending', `Rs ${totalPending.toLocaleString()}`);
            setTxt('statPendingCount', `${pendingCount} Baqi Bill`);
            setTxt('statToday', `Rs ${totalPaid.toLocaleString()}`);
            setTxt('statPaidCount', `${paidCount} Ada Shuda`);
            setTxt('statTotalDemand', `Rs ${totalDemand.toLocaleString()}`);
            setTxt('statRate', `${recoveryRate}% Recovery`);

            setTxt('countPending', pendingCount);
            setTxt('countPaid', paidCount);
            setTxt('countAll', totalCount);

            // Desktop stats
            // Card 1: Total Due (Kul Baqi Bill) - directly decreases as payments are received
            setTxt('deskStatPending', `Rs ${totalPending.toLocaleString()}`);
            setTxt('deskStatPendingUsers', pendingCount);
            // Card 2: Wasool Shuda (Received Cash)
            setTxt('deskStatPaid', `Rs ${totalPaid.toLocaleString()}`);
            setTxt('deskStatPaidUsers', paidCount);
            setTxt('deskStatRate', `${recoveryRate}%`);
            // Card 3: Kul Mahana Demand (Gross Demand)
            setTxt('deskStatTotal', `Rs ${totalDemand.toLocaleString()}`);
            setTxt('deskStatTotalCount', totalCount);

            // Navigation & Filter Badges
            setTxt('deskCountPending', pendingCount);
            setTxt('deskCountPaid', paidCount);
            setTxt('deskFilterPending', pendingCount);
            setTxt('deskFilterPaid', paidCount);
            setTxt('deskFilterAll', totalCount);
            setTxt('tableCountAll', totalCount);
            setTxt('tableCountPending', pendingCount);
            setTxt('tableCountPaid', paidCount);
            setTxt('deskCountAllNav', totalCount);
            setTxt('mobSideCountAll', totalCount);
            setTxt('mobSideCountPending', pendingCount);
            setTxt('mobSideCountPaid', paidCount);
            setTxt('mobDrawerIspName', ispName);
            setTxt('mobBottomPendingBadge', pendingCount);

            if (typeof updateDedicatedPageHeaders === 'function') {
                updateDedicatedPageHeaders(currentAppPage);
            }

            // Update Defaulter Banners (Desktop & Mobile) - only show on dedicated defaultUsers page
            const defDesk = document.getElementById('defaulterBannerDesk');
            const defMob = document.getElementById('defaulterBannerMobile');
            if (currentAppPage === 'defaultUsers') {
                if (defDesk) {
                    defDesk.classList.remove('hidden');
                    setTxt('defaulterDeskBadge', `${pendingCount} Users`);
                    setTxt('defaulterDeskAmount', `Kul Baqi Raqam: Rs ${totalPending.toLocaleString()}`);
                }
                if (defMob) {
                    defMob.classList.remove('hidden');
                    setTxt('defaulterMobBadge', `${pendingCount} Users`);
                    setTxt('defaulterMobAmount', `Baqi: Rs ${totalPending.toLocaleString()}`);
                }
            } else {
                if (defDesk) defDesk.classList.add('hidden');
                if (defMob) defMob.classList.add('hidden');
            }

            // Update Chart if rendered
            updateDesktopChart(totalPaid, totalDemand);
        }

        let deskChartInstance = null;
        function updateDesktopChart(paid, total) {
            const ctx = document.getElementById('deskChart');
            if (!ctx) return;

            if (deskChartInstance) {
                deskChartInstance.data.datasets[0].data = [12000, 15000, 18500, 17200, 22000, paid];
                deskChartInstance.update();
                return;
            }

            deskChartInstance = new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: ['Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov (Current)'],
                    datasets: [
                        {
                            label: 'Wasool Shuda (Cash Collected)',
                            data: [12000, 15000, 18500, 17200, 22000, paid],
                            backgroundColor: '#2563EB',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { borderDash: [2, 4] } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // Add or Update Customer with Confirmation Popup
        function saveCustomer(e) {
            e.preventDefault();
            const editId = document.getElementById('editCustomerId').value;
            const name = document.getElementById('custName').value.trim();
            const phone = document.getElementById('custPhone').value.trim();
            const userid = document.getElementById('custUserid').value.trim();
            const area = document.getElementById('custArea').value.trim();
            const packageVal = document.getElementById('custPackage').value.trim();
            const fee = Number(document.getElementById('custFee').value) || 0;
            const expireDate = document.getElementById('custExpireDate').value.trim();
            const password = document.getElementById('custPassword').value.trim();

            showConfirm({
                title: editId ? 'Customer Update Karein?' : 'Naya Customer Shamil Karein?',
                message: `Kya aap ${name} (Mahana Bill: Rs. ${fee.toLocaleString()}) ki details ko save karna chahte hain?`,
                icon: 'fa-floppy-disk',
                iconBg: 'bg-blue-100 text-blue-600',
                btnText: 'Haan, Save Karein',
                btnClass: 'bg-blue-600 hover:bg-blue-700 text-white shadow-blue-500/25',
                onConfirm: () => {
                    if (editId) {
                        const cust = customers.find(c => c.id == editId);
                        if (cust) {
                            cust.name = name;
                            cust.phone = phone;
                            cust.userid = userid;
                            cust.area = area;
                            cust.package = packageVal;
                            cust.fee = fee;
                            cust.expireDate = expireDate;
                            cust.password = password;
                            toastr.success("Customer ki details update ho gayin!");
                        }
                    } else {
                        const newCustomer = {
                            id: Date.now(),
                            name,
                            phone,
                            userid,
                            area,
                            package: packageVal || "Fiber Net",
                            fee,
                            expireDate: expireDate || '',
                            password: password || '',
                            status: "PENDING",
                            paidAt: null
                        };
                        customers.unshift(newCustomer);
                        toastr.success("Naya customer kamyabi se shamil ho gaya!");
                    }

                    saveToStorage();
                    closeModal('addModal');
                    renderAllViews();
                    try {
                        pushDataToCloud(true);
                    } catch (e) {}
                }
            });
        }

        function editCustomer(id) {
            const c = customers.find(item => String(item.id) === String(id));
            if (!c) return;

            document.getElementById('editCustomerId').value = c.id;
            document.getElementById('modalTitle').textContent = "Customer Edit Karein";
            document.getElementById('custName').value = c.name;
            document.getElementById('custPhone').value = c.phone;
            document.getElementById('custUserid').value = c.userid || '';
            document.getElementById('custArea').value = c.area;
            document.getElementById('custPackage').value = c.package || '';
            document.getElementById('custFee').value = c.fee;
            document.getElementById('custExpireDate').value = c.expireDate || '';
            document.getElementById('custPassword').value = c.password || '';

            openModal('addModal');
        }

        // Start New Month with Confirmation Popup
        function startNewMonth() {
            showConfirm({
                title: 'Naya Maheena Shuru Karein?',
                message: 'Kya aap waqai naya maheena shuru karna chahte hain? Tamam customers ka bill status dobara Baqi (Pending) ho jayega.',
                icon: 'fa-rotate',
                iconBg: 'bg-amber-100 text-amber-600',
                btnText: 'Haan, Naya Maheena Karein',
                btnClass: 'bg-amber-600 hover:bg-amber-700 text-white shadow-amber-500/25',
                onConfirm: () => {
                    customers.forEach(c => {
                        c.status = 'PENDING';
                        c.paidAt = null;
                        c.paidAmount = 0;
                        c.dueAmount = Number(c.fee) || 0;
                    });
                    saveToStorage();
                    renderAllViews();
                    closeModal('settingsModal');
                    toastr.success("Naya maheena shuru ho gaya! Tamam bill pending ho gaye.");
                }
            });
        }

        function sendBulkReminderNotice() {
            const pendingList = customers.filter(c => c.status !== 'PAID');
            if (pendingList.length === 0) {
                toastr.info("Tamam users pehle hi paid hain! Koi bill baqi nahi.");
                return;
            }
            showConfirm({
                title: 'WhatsApp Reminders Bhejein?',
                message: `Kul ${pendingList.length} baqi users ko SonyBox bill reminder list open karein?`,
                icon: 'fa-whatsapp',
                iconBg: 'bg-emerald-100 text-emerald-700',
                btnText: 'Haan, Open Karein',
                btnClass: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/25',
                onConfirm: () => {
                    toastr.success(`${pendingList.length} baqi users ke WhatsApp reminders tayyar hain!`);
                }
            });
        }

        // ----------------------------------------------------
        // 📥 UNIVERSAL BULK IMPORTER FUNCTIONS (8-COLUMN EXCEL/CSV)
        // Format: Name | Phone | UserID | Area | Package | Monthly Fee | expiration_date | Password
        // ----------------------------------------------------
        function downloadSampleCSV() {
            const headers = "Name,Phone,UserID,Area,Package,Monthly Fee,expiration_date,Password\r\n";
            const sampleRows = [
                "Chaudhry Akram,03001234567,akram_fiber,Gali # 1,20 Mbps,1800,2026-11-30,123456",
                "Haji Usman,03217654321,usman_gali2,Gali # 2,15 Mbps,1500,2026-12-05,pass@123",
                "Muhammad Bilal,03459876543,bilal_bazar,Main Bazar,30 Mbps,2500,2026-11-28,bilal321",
                "Master Tariq,03024567890,tariq_school,School Wali Gali,15 Mbps,1500,2026-12-10,tariq786",
                "Rana Zulfiqar,03335551234,rana_net,Block B,25 Mbps,2000,2026-11-25,rana99"
            ].join("\r\n");

            const csvContent = "\uFEFF" + headers + sampleRows;
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "SonyBox_Customer_Import_Template.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            toastr.success("Excel 8-Column Import Template download ho gaya!");
        }

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;
            document.getElementById('importFileName').textContent = file.name;
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('csvPasteArea').value = e.target.result;
                toastr.info(`${file.name} load ho gayi! Ab 'Bulk Import Shuru Karein' dabayein.`);
            };
            reader.readAsText(file);
        }

        function splitLineToTokens(line) {
            if (line.includes('\t')) {
                return line.split('\t').map(p => p.trim().replace(/^["']|["']$/g, ''));
            }
            let tokens = [];
            let cur = '';
            let inQuotes = false;
            for (let c = 0; c < line.length; c++) {
                let ch = line[c];
                if (ch === '"') {
                    inQuotes = !inQuotes;
                } else if ((ch === ',' || ch === ';') && !inQuotes) {
                    tokens.push(cur.trim().replace(/^["']|["']$/g, ''));
                    cur = '';
                } else {
                    cur += ch;
                }
            }
            tokens.push(cur.trim().replace(/^["']|["']$/g, ''));
            return tokens;
        }

        function processBulkImport() {
            const rawText = document.getElementById('csvPasteArea').value.trim();
            if (!rawText) {
                toastr.error("Pehle Excel file upload karein ya text paste karein.");
                return;
            }

            const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
            if (lines.length === 0) {
                toastr.error("Koi valid data nahi mila.");
                return;
            }

            let startIndex = 0;
            // Default 8-Column order:
            // 0: Name | 1: Phone | 2: UserID | 3: Area | 4: Package | 5: Monthly Fee | 6: expiration_date | 7: Password
            let colMap = {
                name: 0,
                phone: 1,
                userid: 2,
                area: 3,
                package: 4,
                fee: 5,
                expireDate: 6,
                password: 7
            };

            const firstLineTokens = splitLineToTokens(lines[0]);
            const isHeader = firstLineTokens.some(t => {
                const lower = t.toLowerCase();
                return /name|naam|phone|mobile|userid|user.*id|package|plan|fee|bill|expiration|expiry|password|secret/.test(lower);
            });

            if (isHeader) {
                startIndex = 1;
                firstLineTokens.forEach((token, idx) => {
                    const t = token.toLowerCase();
                    if (/name|naam|customer|grahak/.test(t) && !/user/.test(t)) colMap.name = idx;
                    else if (/phone|mobile|cell|contact|number|whatsapp/.test(t)) colMap.phone = idx;
                    else if (/user.*id|username|login/.test(t) || t === 'id') colMap.userid = idx;
                    else if (/area|ilaqa|gali|address|location|sector/.test(t)) colMap.area = idx;
                    else if (/package|pkg|plan|speed|profile|tariff/.test(t)) colMap.package = idx;
                    else if (/fee|bill|monthly|amount|rate|price|charges/.test(t)) colMap.fee = idx;
                    else if (/expir|expiry|validity|date|khatam/.test(t)) colMap.expireDate = idx;
                    else if (/pass|secret|code/.test(t)) colMap.password = idx;
                });
            }

            const parsedCustomers = [];
            for (let i = startIndex; i < lines.length; i++) {
                const parts = splitLineToTokens(lines[i]);
                if (parts.length < 2) continue;

                let name = (colMap.name !== -1 && parts[colMap.name] !== undefined) ? parts[colMap.name] : '';
                let rawPhone = (colMap.phone !== -1 && parts[colMap.phone] !== undefined) ? parts[colMap.phone] : '';
                let userid = (colMap.userid !== -1 && parts[colMap.userid] !== undefined) ? parts[colMap.userid] : '';
                let area = (colMap.area !== -1 && parts[colMap.area] !== undefined) ? parts[colMap.area] : '';
                let packageVal = (colMap.package !== -1 && parts[colMap.package] !== undefined) ? parts[colMap.package] : '';
                let rawFee = (colMap.fee !== -1 && parts[colMap.fee] !== undefined) ? parts[colMap.fee] : '';
                let expireDate = (colMap.expireDate !== -1 && parts[colMap.expireDate] !== undefined) ? parts[colMap.expireDate] : '';
                let password = (colMap.password !== -1 && parts[colMap.password] !== undefined) ? parts[colMap.password] : '';

                // If no header detected and row has >= 8 tokens, guarantee exact 8-column position
                if (!isHeader && parts.length >= 8) {
                    name = parts[0];
                    rawPhone = parts[1];
                    userid = parts[2];
                    area = parts[3];
                    packageVal = parts[4];
                    rawFee = parts[5];
                    expireDate = parts[6];
                    password = parts[7];
                }

                // Normalise Pakistani Phone
                let phoneDigits = rawPhone.replace(/[^0-9]/g, '');
                let phone = rawPhone;
                if (phoneDigits.length >= 9) {
                    if (phoneDigits.length === 11 && phoneDigits.endsWith('0') && (phoneDigits.startsWith('3') || phoneDigits.startsWith('03'))) {
                        phoneDigits = phoneDigits.slice(0, 10);
                    }
                    if (phoneDigits.startsWith('92') && phoneDigits.length === 12) {
                        phone = '0' + phoneDigits.substring(2);
                    } else if (!phoneDigits.startsWith('0') && phoneDigits.length === 10) {
                        phone = '0' + phoneDigits;
                    } else if (phoneDigits.startsWith('0') && phoneDigits.length === 11) {
                        phone = phoneDigits;
                    }
                }

                // Normalise Fee
                let fee = 1500;
                if (rawFee) {
                    let cleanedNum = Number(String(rawFee).replace(/[^0-9]/g, ''));
                    if (cleanedNum > 0) fee = cleanedNum;
                }

                if (!area || area === '-') area = 'General';
                if (!packageVal || packageVal === '-') packageVal = 'Fiber Net';

                if (!name && userid) {
                    name = userid.replace(/^[a-zA-Z0-9]*[-_]/, '').trim() || userid;
                } else if (!name) {
                    name = `User ${parsedCustomers.length + 1}`;
                }

                if (!userid) {
                    userid = name.toLowerCase().replace(/[^a-z0-9]/g, '_');
                }

                if (expireDate === '-') expireDate = '';
                if (password === '-') password = '';

                parsedCustomers.push({
                    id: Date.now() + Math.floor(Math.random() * 100000) + i,
                    name: name.trim(),
                    phone: phone.trim(),
                    userid: userid.trim(),
                    area: area.trim(),
                    package: packageVal.trim(),
                    fee: fee,
                    expireDate: expireDate.trim(),
                    password: password.trim(),
                    status: 'PENDING',
                    paidAt: null
                });
            }

            if (parsedCustomers.length === 0) {
                toastr.error("Ghalat data format. Format: Name | Phone | UserID | Area | Package | Monthly Fee | expiration_date | Password");
                return;
            }

            const mode = document.querySelector('input[name="importMode"]:checked').value;
            const modeText = mode === 'replace' ? 'Purana tamam data delete karke sirf ye naye' : 'Existing customers mein';

            showConfirm({
                title: 'Bulk Import Confirm Karein?',
                message: `Kul ${parsedCustomers.length} customers (${modeText}) import hone lagay hain. Kya aap mutma'in hain?`,
                icon: 'fa-file-import',
                iconBg: 'bg-cyan-100 text-cyan-700',
                btnText: 'Haan, Import Karein',
                btnClass: 'bg-cyan-600 hover:bg-cyan-700 text-white shadow-cyan-500/25',
                onConfirm: () => {
                    if (mode === 'replace') {
                        customers = parsedCustomers;
                    } else {
                        customers = [...customers, ...parsedCustomers];
                    }
                    saveToStorage();
                    renderAllViews();
                    closeModal('importModal');
                    document.getElementById('csvPasteArea').value = '';
                    document.getElementById('importFileName').textContent = 'File muntakhib karein (.csv ya .txt)';
                    toastr.success(`Mubarak! ${parsedCustomers.length} customers kamyabi se import ho gaye!`);
                }
            });
        }

        // ----------------------------------------------------
        // 📤 UNIVERSAL EXPORTER FUNCTIONS (8-COLUMN COMPLIANT)
        // ----------------------------------------------------
        function exportToCSV(filterType = 'ALL') {
            let exportList = customers;
            let filePrefix = 'SonyBox_ISP_All_Customers';
            let label = 'Tamam Customers';

            if (filterType === 'PENDING') {
                exportList = customers.filter(c => c.status !== 'PAID');
                filePrefix = 'SonyBox_ISP_Defaulters_Baqi_Bill';
                label = 'Sirf Baqi (Pending) Defaulters';
            }

            showConfirm({
                title: 'Excel Report Download Karein?',
                message: `Kya aap ${label} (${exportList.length} users) ki CSV / Excel file download karna chahte hain?`,
                icon: 'fa-file-excel',
                iconBg: 'bg-emerald-100 text-emerald-700',
                btnText: 'Haan, Download Karein',
                btnClass: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/25',
                onConfirm: () => {
                    let csv = "\uFEFFName,Phone,UserID,Area,Package,Monthly Fee,expiration_date,Password,Status,Paid Amount,Due Amount,Paid At\r\n";
                    exportList.forEach(c => {
                        const clean = (val) => String(val || '').replace(/"/g, '""');
                        const isPaid = c.status === 'PAID';
                        const paidAmt = (c.paidAmount !== undefined && c.paidAmount !== null) ? c.paidAmount : (isPaid ? c.fee : 0);
                        const dueAmt = (c.dueAmount !== undefined && c.dueAmount !== null) ? c.dueAmount : (isPaid ? 0 : c.fee);
                        csv += `"${clean(c.name)}","${clean(c.phone)}","${clean(c.userid)}","${clean(c.area)}","${clean(c.package)}","${c.fee}","${clean(c.expireDate)}","${clean(c.password)}","${clean(c.status)}","${paidAmt}","${dueAmt}","${clean(c.paidAt)}"\r\n`;
                    });

                    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                    const link = document.createElement("a");
                    link.href = URL.createObjectURL(blob);
                    link.setAttribute("download", `${filePrefix}_${new Date().toISOString().slice(0,10)}.csv`);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    closeModal('exportModal');
                    toastr.success(`Excel Report (${exportList.length} users) download ho gayi!`);
                }
            });
        }

        function printFieldSheet() {
            const pendingList = customers.filter(c => c.status !== 'PAID');
            if (pendingList.length === 0) {
                toastr.info("Tamam users pehle hi paid hain! Koi bill baqi nahi.");
                return;
            }

            showConfirm({
                title: 'Field Recovery Sheet Kholein?',
                message: `Baqi ${pendingList.length} users ki print recovery sheet open karein?`,
                icon: 'fa-print',
                iconBg: 'bg-blue-100 text-blue-700',
                btnText: 'Haan, Open Karein',
                btnClass: 'bg-blue-600 hover:bg-blue-700 text-white shadow-blue-500/25',
                onConfirm: () => {
                    closeModal('exportModal');
                    let printWin = window.open('', '_blank');
                    if (!printWin) {
                        toastr.error("Browser popups allow karein print ke liye.");
                        return;
                    }

                    let html = `
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <title>SonyBox ISP - Field Recovery Sheet</title>
                        <style>
                            body { font-family: Arial, sans-serif; padding: 20px; font-size: 12px; }
                            h2 { margin: 0; color: #1e3a8a; }
                            table { width: 100%; border-collapse: collapse; margin-top: 15px; }
                            th, td { border: 1px solid #94a3b8; padding: 8px 10px; text-align: left; }
                            th { background-color: #f1f5f9; font-weight: bold; }
                            .center { text-align: center; }
                            .box { width: 18px; height: 18px; border: 2px solid #000; display: inline-block; border-radius: 3px; }
                            @media print { button { display: none; } }
                        </style>
                    </head>
                    <body>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <h2>SonyBox ISP - Field Recovery Sheet</h2>
                                <p style="margin:4px 0; color:#64748b;">Billing Cycle: November 2026 | Total Baqi Accounts: ${pendingList.length}</p>
                            </div>
                            <button onclick="window.print()" style="padding:8px 16px; background:#2563eb; color:#fff; border:none; border-radius:6px; cursor:pointer; font-weight:bold;">Print Document</button>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:30px;">#</th>
                                    <th>User Ka Naam</th>
                                    <th>Phone / WhatsApp</th>
                                    <th>Ilaqa / Gali</th>
                                    <th>Package</th>
                                    <th>Baqi Rakam</th>
                                    <th class="center" style="width:60px;">Tick</th>
                                    <th style="width:120px;">Dastakhat (Sign)</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${pendingList.map((c, i) => `
                                <tr>
                                    <td>${i + 1}</td>
                                    <td><strong>${c.name}</strong><br><small style="color:#64748b;">${c.userid || ''}</small></td>
                                    <td>${c.phone}</td>
                                    <td>${c.area}</td>
                                    <td>${c.package}</td>
                                    <td><strong>Rs. ${Number(c.fee).toLocaleString()}</strong></td>
                                    <td class="center"><span class="box"></span></td>
                                    <td></td>
                                </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </body>
                    </html>
                    `;
                    printWin.document.write(html);
                    printWin.document.close();
                }
            });
        }

        // JSON Backup download & restore
        function exportJSONBackup() {
            showConfirm({
                title: 'Mukammal Backup Download Karein?',
                message: `Tamam ISP customers aur system data ki JSON backup file download karein?`,
                icon: 'fa-cloud-arrow-down',
                iconBg: 'bg-blue-100 text-blue-700',
                btnText: 'Haan, Backup Lein',
                btnClass: 'bg-blue-600 hover:bg-blue-700 text-white shadow-blue-500/25',
                onConfirm: () => {
                    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(customers, null, 2));
                    const dlAnchor = document.createElement('a');
                    dlAnchor.setAttribute("href", dataStr);
                    dlAnchor.setAttribute("download", `SonyBox_ISP_Backup_${new Date().toISOString().slice(0,10)}.json`);
                    dlAnchor.click();
                    closeModal('settingsModal');
                    closeModal('exportModal');
                    toastr.success("Backup file download ho gayi!");
                }
            });
        }

        function importJSONBackup(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (Array.isArray(imported)) {
                        showConfirm({
                            title: 'Backup Restore Karein?',
                            message: `Is file se ${imported.length} customers restore honge aur majooda data replace ho jayega. Kya aap mutma'in hain?`,
                            icon: 'fa-cloud-arrow-up',
                            iconBg: 'bg-emerald-100 text-emerald-700',
                            btnText: 'Haan, Restore Karein',
                            btnClass: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/25',
                            onConfirm: () => {
                                customers = imported;
                                saveToStorage();
                                renderAllViews();
                                closeModal('settingsModal');
                                closeModal('exportModal');
                                toastr.success("Backup kamyabi se restore ho gaya!");
                            }
                        });
                    } else {
                        toastr.error("Ghalat file format.");
                    }
                } catch(err) {
                    toastr.error("File read nahi ho saki.");
                }
            };
            reader.readAsText(file);
        }

        // ----------------------------------------------------
        // 📱 DESKTOP SIDEBAR MINIMIZE / MAXIMIZE ACTION
        // ----------------------------------------------------
        function toggleSidebar() {
            const sidebar = document.getElementById('desktopSidebar');
            if (!sidebar) return;
            const isCollapsed = sidebar.classList.toggle('sidebar-collapsed');
            localStorage.setItem('rm_isp_sidebar_collapsed', isCollapsed ? 'true' : 'false');

            const toggleIcon = document.getElementById('sidebarToggleIcon');
            const innerIcon = document.getElementById('sidebarInnerToggleIcon');

            if (isCollapsed) {
                if (toggleIcon) toggleIcon.className = 'fa-solid fa-bars text-sm';
                if (innerIcon) innerIcon.className = 'fa-solid fa-angles-right text-xs';
                toastr.info("Sidebar minimize ho gaya");
            } else {
                if (toggleIcon) toggleIcon.className = 'fa-solid fa-bars-staggered text-sm';
                if (innerIcon) innerIcon.className = 'fa-solid fa-angles-left text-xs';
                toastr.info("Sidebar maximize ho gaya");
            }
        }

        function initSidebarState() {
            const savedState = localStorage.getItem('rm_isp_sidebar_collapsed');
            if (savedState === 'true') {
                const sidebar = document.getElementById('desktopSidebar');
                if (sidebar) {
                    sidebar.classList.add('sidebar-collapsed');
                    const toggleIcon = document.getElementById('sidebarToggleIcon');
                    const innerIcon = document.getElementById('sidebarInnerToggleIcon');
                    if (toggleIcon) toggleIcon.className = 'fa-solid fa-bars text-sm';
                    if (innerIcon) innerIcon.className = 'fa-solid fa-angles-right text-xs';
                }
            }
        }

        // ----------------------------------------------------
        // 📱 MOBILE SIDE DRAWER (OFF-CANVAS SIDE MENU)
        // ----------------------------------------------------
        function toggleMobileSideMenu() {
            const menu = document.getElementById('mobileSideMenu');
            const backdrop = document.getElementById('mobileSideMenuBackdrop');
            if (!menu || !backdrop) return;
            const isHidden = menu.classList.contains('-translate-x-full');
            if (isHidden) {
                backdrop.classList.remove('hidden');
                setTimeout(() => {
                    menu.classList.remove('-translate-x-full');
                }, 10);
            } else {
                closeMobileSideMenu();
            }
        }

        function closeMobileSideMenu() {
            const menu = document.getElementById('mobileSideMenu');
            const backdrop = document.getElementById('mobileSideMenuBackdrop');
            if (!menu || !backdrop) return;
            menu.classList.add('-translate-x-full');
            setTimeout(() => {
                backdrop.classList.add('hidden');
            }, 300);
        }

        function scrollToCustomers() {
            const el = window.innerWidth >= 1024 
                ? document.getElementById('customerTableContainer') 
                : document.getElementById('customerList');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // ----------------------------------------------------
        // 🔧 BILL & PHONE NUMBER DATA REPAIR TOOL
        // ----------------------------------------------------
        function checkCorruptedBills() {
            let corruptedCount = customers.filter(c => Number(c.fee) > 50000).length;
            const banner = document.getElementById('fixDataBanner');
            const mobileBanner = document.getElementById('fixDataBannerMobile');
            if (banner) banner.classList.toggle('hidden', corruptedCount === 0);
            if (mobileBanner) mobileBanner.classList.toggle('hidden', corruptedCount === 0);
            return corruptedCount;
        }

        function fixCorruptedCustomerData(isUserClick = false) {
            let corruptedList = customers.filter(c => Number(c.fee) > 50000);
            if (corruptedList.length === 0) {
                if (isUserClick) toastr.info("Tamam users ka bill pehle se hi theek hai.");
                checkCorruptedBills();
                return;
            }

            let defaultFee = 1500;
            if (isUserClick) {
                let userChoice = prompt(`Kul ${corruptedList.length} users ka bill (Rs. 32 Billion) phone number se mix ho gaya hai.\n\nInka Mahana Bill kitne Rupay set karein?`, "1500");
                if (userChoice === null) return;
                let parsed = Number(userChoice.replace(/[^0-9]/g, ''));
                if (parsed > 0) defaultFee = parsed;
            }

            let fixedCount = 0;
            customers.forEach(c => {
                let numericFee = Number(c.fee) || 0;
                // If fee is greater than 50,000, it's 100% a phone number!
                if (numericFee > 50000) {
                    let phoneStr = numericFee.toString().replace(/[^0-9]/g, '');
                    // In Excel scientific notation: 03234894124 became 3.234894124E+10 -> 32348941240 (11 digits ending with 0)
                    if (phoneStr.length === 11 && phoneStr.endsWith('0') && (phoneStr.startsWith('3') || phoneStr.startsWith('03'))) {
                        phoneStr = phoneStr.slice(0, 10);
                    }
                    if (!phoneStr.startsWith('0') && phoneStr.length === 10) {
                        phoneStr = '0' + phoneStr;
                    } else if (phoneStr.startsWith('92') && phoneStr.length === 12) {
                        phoneStr = '0' + phoneStr.substring(2);
                    }
                    c.phone = phoneStr;
                    c.fee = defaultFee;

                    // If name was just an ID number (like 659, 661) and userid is real (e.g. NAZ1-FAISAL)
                    if (/^\d+$/.test(c.name.trim()) && c.userid && !/^\d+$/.test(c.userid.trim())) {
                        c.name = c.userid.replace(/^[a-zA-Z0-9]*[-_]/, '').trim() || c.userid;
                    }
                    fixedCount++;
                }
            });

            saveToStorage();
            renderAllViews();
            checkCorruptedBills();
            toastr.success(`Mubarak! ${fixedCount} users ka WhatsApp phone number aur bill (Rs. ${defaultFee.toLocaleString()}) theek ho gaya!`);
        }

        // Modals control
        function openModal(id) {
            if (id === 'addModal' && !document.getElementById('editCustomerId').value) {
                document.getElementById('modalTitle').textContent = "Naya Customer Shamil Karein";
                document.getElementById('customerForm').reset();
                document.getElementById('editCustomerId').value = '';
            }
            if (id === 'settingsModal') {
                document.getElementById('lockEnabledToggle').checked = isLockEnabled;
            }
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            if (id === 'addModal') {
                document.getElementById('editCustomerId').value = '';
                document.getElementById('customerForm').reset();
            }
            if (id === 'historyModal') {
                closeHistoryOptionsMenu();
            }
        }

        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('./sw.js').catch(() => {});
            });
        }

        // Initialize on load
        $(document).ready(function() {
            initSidebarState();
            fixCorruptedCustomerData(false);
            checkCorruptedBills();
            customers.forEach(c => ensureCustomerHistory(c));
            document.getElementById('deskIspName').textContent = ispName;
            document.getElementById('ispNameInput').value = ispName;
            if (document.getElementById('ispJazzcashInput')) document.getElementById('ispJazzcashInput').value = ispJazzcash;
            if (document.getElementById('ispHelplineInput')) document.getElementById('ispHelplineInput').value = ispHelpline;
            checkLockStatus();
            updateStats();

            // Handle URL Hash or default to Dashboard Overview
            const initHash = window.location.hash;
            if (initHash === '#default-users' || initHash === '#defaultUsers') {
                openPage('defaultUsers', true);
            } else if (initHash === '#paid-customers' || initHash === '#paidCustomers' || initHash === '#paid-users') {
                openPage('paidCustomers', true);
            } else if (initHash === '#all-customers' || initHash === '#allCustomers') {
                openPage('allCustomers', true);
            } else {
                openPage('dashboard', true);
            }

            // Browser Back / Forward Button and Hash Change Listener
            window.addEventListener('hashchange', () => {
                const h = window.location.hash;
                if (h === '#default-users' || h === '#defaultUsers') {
                    if (currentAppPage !== 'defaultUsers') openPage('defaultUsers', false);
                } else if (h === '#paid-customers' || h === '#paidCustomers' || h === '#paid-users') {
                    if (currentAppPage !== 'paidCustomers') openPage('paidCustomers', false);
                } else if (h === '#all-customers' || h === '#allCustomers') {
                    if (currentAppPage !== 'allCustomers') openPage('allCustomers', false);
                } else {
                    if (currentAppPage !== 'dashboard') openPage('dashboard', false);
                }
            });

            // ☁️ 1. OPEN / LAUNCH AUTO-SYNC (runs immediately on open)
            syncWithServer(false, false);

            // ☁️ 2. PAGESHOW AUTO-SYNC (triggers on mobile phones when returning to browser or tab)
            window.addEventListener('pageshow', () => {
                syncWithServer(false, false);
            });

            // ☁️ 3. VISIBILITY AUTO-SYNC (triggers when phone is unlocked or tab is switched)
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden && !isSyncInProgress) {
                    syncWithServer(false, false);
                }
            });

            // ☁️ 4. FOCUS AUTO-SYNC (triggers on click/tap into browser)
            window.addEventListener('focus', () => {
                if (!isSyncInProgress) {
                    syncWithServer(false, false);
                }
            });

            // ☁️ 5. NETWORK RECONNECT AUTO-SYNC
            window.addEventListener('online', () => {
                toastr.info("Network connected. Auto-syncing...");
                syncWithServer(false, true);
            });

            // ☁️ 6. REAL-TIME BACKGROUND POLLING (every 3.5 seconds)
            setInterval(() => {
                if (!document.hidden && !isSyncInProgress) {
                    syncWithServer(false, false);
                }
            }, 3500);
        });
    </script>
</body>
</html>
