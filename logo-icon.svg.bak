<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120" fill="none">
  <defs>
    <linearGradient id="rmGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563EB" />
      <stop offset="50%" stop-color="#3B82F6" />
      <stop offset="100%" stop-color="#06B6D4" />
    </linearGradient>
    <linearGradient id="rmGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="100%" stop-color="#3B82F6" />
    </linearGradient>
    <filter id="rmGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#2563EB" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background rounded squircle with subtle glass glow -->
  <rect x="6" y="6" width="108" height="108" rx="28" fill="url(#rmGrad1)" filter="url(#rmGlow)" />
  <rect x="6.5" y="6.5" width="107" height="107" rx="27.5" stroke="rgba(255,255,255,0.3)" stroke-width="1.5" fill="none" />

  <!-- Dynamic Recovery Loop & Upward Growth / M & R fusion -->
  <g transform="translate(20, 20)">
    <!-- Recovery circular continuous path -->
    <path d="M 40 10 A 30 30 0 1 1 18 64" stroke="rgba(255, 255, 255, 0.4)" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 6" fill="none" />
    
    <!-- Bold energetic 'R' and upward 'M' pulse -->
    <path d="M 22 66 L 22 18 C 22 18, 38 14, 48 24 C 57 33, 49 44, 38 46 L 56 66" 
          stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none" />

    <!-- Upward Trend / Smile / Recovery Arrow -->
    <path d="M 36 34 L 46 24 L 56 34" stroke="url(#rmGrad2)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    
    <!-- Accent Sparkle / Positive Mood Dot -->
    <circle cx="58" cy="18" r="4.5" fill="#34D399" />
  </g>
</svg>
