<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 90" width="380" height="90" fill="none">
  <defs>
    <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563EB" />
      <stop offset="100%" stop-color="#06B6D4" />
    </linearGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0284C7" />
      <stop offset="100%" stop-color="#10B981" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#0284C7" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Logo Icon -->
  <g transform="translate(10, 10)">
    <rect width="70" height="70" rx="18" fill="url(#logoGrad)" filter="url(#shadow)"/>
    <rect x="0.5" y="0.5" width="69" height="69" rx="17.5" stroke="rgba(255,255,255,0.4)" stroke-width="1"/>
    
    <!-- Dynamic R + upward recovery arrow -->
    <path d="M 22 52 L 22 18 C 22 18, 36 14, 44 22 C 51 29, 44 38, 34 40 L 48 52" 
          stroke="#FFFFFF" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <path d="M 33 29 L 41 21 L 49 29" stroke="#34D399" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="51" cy="16" r="3.5" fill="#38BDF8"/>
  </g>

  <!-- Typography -->
  <g transform="translate(96, 52)">
    <text font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" 
          font-size="34" font-weight="800" letter-spacing="-0.5" fill="#0F172A">Sony<tspan fill="url(#textGrad)">Box</tspan></text>
  </g>
  <g transform="translate(98, 70)">
    <text font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" 
          font-size="10.5" font-weight="600" letter-spacing="2.8" fill="#64748B">INTELLIGENT RECOVERY & BILLING</text>
  </g>
</svg>
